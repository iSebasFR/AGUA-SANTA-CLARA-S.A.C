{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "Alertas": {
    "HoraEjecucion": 22,
    "MinutoEjecucion": 0,
    "UtcOffsetHoras": -5,
    "FrecuenciaDias": 1,
    "IntervaloRevisionSegundos": 30
  },
  "AllowedHosts": "*"
}