@model AguaSantaClara.Web.Models.ProductosIndexViewModel

@{
    ViewData["Title"] = "Catálogo de productos";
    var puedeAdministrar = User.IsInRole("Administradora") || User.IsInRole("Gerente");
}

<div class="container py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4 mb-1">Catálogo de productos</h1>
            <p class="text-muted mb-0">Administra los productos disponibles.</p>
        </div>
        @if (puedeAdministrar)
        {
            <button type="button" class="btn btn-primary" id="btnNuevoProducto">
                <i class="bi bi-plus-lg me-1"></i> Nuevo producto
            </button>
        }
    </div>

    <!-- MENSAJES -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <!-- FILTROS -->
    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <input name="search" value="@Model.Search" class="form-control"
                   placeholder="Buscar por nombre de producto" />
        </div>
        <div class="col-md-3">
            <select name="categoria" class="form-select" asp-items="Model.Categorias"
                    asp-for="CategoriaFiltro">
            </select>
        </div>
        <div class="col-md-3">
            <select name="estado" class="form-select" asp-items="Model.Estados"
                    asp-for="EstadoFiltro">
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">
                <i class="bi bi-search me-1"></i> Filtrar
            </button>
        </div>
    </form>

    <!-- TABLA -->
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Descripción</th>
                    <th>Precio venta</th>
                    <th>Costo</th>
                    <th>Estado</th>
                    @if (puedeAdministrar)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
            @if (!Model.Productos.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No se encontraron productos.</td>
                </tr>
            }
            @foreach (var producto in Model.Productos)
            {
                <tr>
                    <td><strong>@producto.Nombre</strong></td>
                    <td>
                        <span class="badge text-bg-light border">@producto.Categoria</span>
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(producto.Descripcion) ? "—" : producto.Descripcion)</td>
                    <td>S/ @producto.PrecioVenta.ToString("0.00")</td>
                    <td>S/ @producto.Costo.ToString("0.00")</td>
                    <td>
                        @if (puedeAdministrar)
                        {
                            <select class="form-select form-select-sm" style="width:120px;"
                                    onchange="cambiarEstado(@producto.Id, this.value)">
                                <option value="true" selected="@producto.Estado">Activo</option>
                                <option value="false" selected="@(!producto.Estado)">Inactivo</option>
                            </select>
                        }
                        else
                        {
                            <span class="badge @(producto.Estado ? "text-bg-success" : "text-bg-secondary")">
                                @(producto.Estado ? "Activo" : "Inactivo")
                            </span>
                        }
                    </td>
                    @if (puedeAdministrar)
                    {
                        <td>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        onclick="abrirModalEditar(@producto.Id)">
                                    <i class="bi bi-pencil me-1"></i> Editar
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        onclick="confirmarEliminar(@producto.Id, '@producto.Nombre')">
                                    <i class="bi bi-trash me-1"></i> Eliminar
                                </button>
                            </div>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- FORM OCULTO CAMBIAR ESTADO -->
<form id="formCambiarEstado" asp-action="CambiarEstado" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="estadoId" />
    <input type="hidden" name="estado" id="estadoValor" />
</form>

<!-- FORM OCULTO ELIMINAR -->
<form id="formEliminar" asp-action="Delete" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="eliminarId" />
</form>

<!-- MODAL CREAR -->
@if (puedeAdministrar)
{
    <div class="modal fade" id="modalCrearProducto" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" id="contenidoModalCrear">
                <!-- Contenido cargado vía AJAX -->
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEditarProducto" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" id="contenidoModalEditar">
                <!-- Contenido cargado vía AJAX -->
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // ==================== ABRIR MODAL CREAR ====================
        document.addEventListener('DOMContentLoaded', function () {
            var btnNuevoProducto = document.getElementById('btnNuevoProducto');

            if (btnNuevoProducto) {
                btnNuevoProducto.addEventListener('click', function () {
                    fetch('/Productos/Create')
                        .then(response => {
                            if (!response.ok) throw new Error('Error al cargar el formulario');
                            return response.text();
                        })
                        .then(html => {
                            document.getElementById('contenidoModalCrear').innerHTML = html;
                            var modal = new bootstrap.Modal(document.getElementById('modalCrearProducto'));
                            modal.show();
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('No se pudo cargar el formulario de creación.');
                        });
                });
            }
        });

        // ==================== ABRIR MODAL EDITAR ====================
        function abrirModalEditar(id) {
            fetch('/Productos/Edit/' + id)
                .then(response => {
                    if (!response.ok) throw new Error('Error al cargar el formulario');
                    return response.text();
                })
                .then(html => {
                    document.getElementById('contenidoModalEditar').innerHTML = html;
                    var modal = new bootstrap.Modal(document.getElementById('modalEditarProducto'));
                    modal.show();
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('No se pudo cargar el formulario de edición.');
                });
        }

        // ==================== CAMBIAR ESTADO ====================
        function cambiarEstado(id, valor) {
            if (confirm('¿Está seguro de cambiar el estado de este producto?')) {
                document.getElementById('estadoId').value = id;
                document.getElementById('estadoValor').value = valor;
                document.getElementById('formCambiarEstado').submit();
            } else {
                location.reload();
            }
        }

        // ==================== ELIMINAR ====================
        function confirmarEliminar(id, nombre) {
            if (confirm('¿Seguro eliminar el producto "' + nombre + '"? Esta acción no se puede deshacer.')) {
                document.getElementById('eliminarId').value = id;
                document.getElementById('formEliminar').submit();
            }
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
}