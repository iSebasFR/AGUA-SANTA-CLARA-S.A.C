@model AguaSantaClara.Web.Models.CrearProductoViewModel

<div class="modal-header border-0 pb-0">
    <div>
        <h5 class="modal-title fw-bold">Nuevo producto</h5>
        <p class="text-muted small mb-0">Completa los datos para registrar el producto.</p>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form asp-action="Create" method="post">
    <div class="modal-body pt-3">

        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre <span class="text-danger">*</span></label>
            <input asp-for="Nombre" class="form-control" placeholder="Nombre del producto" />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Categoria" class="form-label">Categoría <span class="text-danger">*</span></label>
            <select asp-for="Categoria" class="form-select">
                <option value="">Seleccione una categoría</option>
                <option value="Bidón">Bidón</option>
                <option value="Galón">Galón</option>
                <option value="Hielo">Hielo</option>
                <option value="Papel">Papel Higiénico</option>
            </select>
            <span asp-validation-for="Categoria" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IdLocales" class="form-label">Locales <span class="text-danger">*</span></label>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var local in Model.Locales)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IdLocales"
                               id="crear-local-@local.Value" value="@local.Value"
                               checked="@(Model.IdLocales.Contains(long.Parse(local.Value!)))" />
                        <label class="form-check-label" for="crear-local-@local.Value">@local.Text</label>
                    </div>
                }
            </div>
            <span asp-validation-for="IdLocales" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <textarea asp-for="Descripcion" class="form-control" rows="2"
                      placeholder="Descripción del producto"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger small"></span>
        </div>

        <div class="row g-3">
            <div class="col-6">
                <label asp-for="PrecioVenta" class="form-label">Precio venta (S/) <span class="text-danger">*</span></label>
                <input asp-for="PrecioVenta" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" />
                <span asp-validation-for="PrecioVenta" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label asp-for="Costo" class="form-label">Costo (S/) <span class="text-danger">*</span></label>
                <input asp-for="Costo" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" />
                <span asp-validation-for="Costo" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-3">
            <label class="form-label d-block">Estado</label>
            <div class="d-flex gap-4">
                <div class="form-check">
                    <input asp-for="Estado" class="form-check-input" type="radio" value="true" checked />
                    <label class="form-check-label">Activo</label>
                </div>
                <div class="form-check">
                    <input asp-for="Estado" class="form-check-input" type="radio" value="false" />
                    <label class="form-check-label">Inactivo</label>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-dark">Guardar</button>
    </div>
</form>

<partial name="_ValidationScriptsPartial" />