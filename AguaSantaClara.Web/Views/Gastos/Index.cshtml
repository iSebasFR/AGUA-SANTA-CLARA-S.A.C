
@model List<AguaSantaClara.Web.Models.Entities.GastoRuta>

@{
    ViewData["Title"] = "Gastos de Ruta";
    var repartidores = ViewBag.Repartidores
        as List<AguaSantaClara.Web.Models.Entities.Repartidor>
        ?? new List<AguaSantaClara.Web.Models.Entities.Repartidor>();
}

<style>
    body.app-body {
        background: linear-gradient(180deg, #eaf4fb 0%, #f0f7fc 40%, #fbfcfd 100%) !important;
        background-attachment: fixed !important;
    }

    .gastos-layout {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .panel-title {
        font-size: 20px;
        font-weight: 700;
        color: #1d1d1f;
        letter-spacing: -0.03em;
        margin: 0;
    }

    .panel-subtitle {
        font-size: 12.5px;
        color: #6e6e73;
        margin: 4px 0 0;
    }

    .btn-apple {
        min-height: 36px;
        padding: 0 16px;
        background: #1d1d1f;
        color: white;
        border: none;
        border-radius: 9px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        gap: 6px;
    }

    .btn-apple:hover {
        background: #000;
        color: white;
    }

    .toolbar-row {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
        padding: 16px 20px;
        background: white;
        border: 1px solid #e5e5ea;
        border-radius: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,.03);
    }

    .select-filter,
    .input-filter {
        min-height: 36px;
        padding: 0 12px;
        border: 1px solid #e5e5ea;
        border-radius: 9px;
        background: #fbfcfd;
        font-family: inherit;
        font-size: 12.5px;
        color: #1d1d1f;
    }

    .select-filter {
        min-width: 190px;
    }

    .card-tabla {
        background: white;
        border: 1px solid #e5e5ea;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,.03);
    }

    .tabla-gastos {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

    .tabla-gastos thead th {
        text-align: left;
        padding: 14px 16px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 600;
        color: #6e6e73;
        text-transform: uppercase;
        letter-spacing: .08em;
        background: #fbfcfd;
        border-bottom: 1px solid #e5e5ea;
        white-space: nowrap;
    }

    .tabla-gastos tbody td {
        padding: 16px;
        font-size: 13px;
        color: #1d1d1f;
        border-bottom: 1px solid #f0f0f2;
        vertical-align: middle;
    }

    .tabla-gastos tbody tr:last-child td {
        border-bottom: none;
    }

    .tabla-gastos tbody tr:hover {
        background: #fbfcfd;
    }

    .badge-tipo {
        display: inline-block;
        padding: 4px 10px;
        background: #eaf4fb;
        color: #3a8ab8;
        border-radius: 6px;
        font-size: 11.5px;
        font-weight: 600;
    }

    .monto-gasto {
        font-weight: 600;
        white-space: nowrap;
    }

    .text-muted-cell {
        color: #6e6e73 !important;
        font-size: 12.5px !important;
    }

    .empty-row {
        text-align: center;
        padding: 50px 20px !important;
        color: #6e6e73 !important;
    }

    .contador-gastos {
        padding: 12px 16px;
        font-size: 12px;
        color: #6e6e73;
        border-top: 1px solid #f0f0f2;
        background: #fbfcfd;
    }

    @@media (max-width: 768px) {
        .toolbar-row {
            padding: 12px;
        }

        .select-filter,
        .input-filter,
        .toolbar-row .btn-apple {
            width: 100%;
        }
    }
</style>

<div class="container py-4 gastos-layout">

    <div class="panel-header">
        <div>
            <h1 class="panel-title">Gastos de Ruta</h1>
            <p class="panel-subtitle">
                Registra y consulta los gastos reportados por los repartidores.
            </p>
        </div>

        <button type="button" class="btn-apple" id="btnNuevoGasto">
            <span aria-hidden="true">＋</span>
            Registrar gasto
        </button>
    </div>

    <form asp-action="Index" method="get" class="toolbar-row">
        <select name="idRepartidor" class="select-filter">
            <option value="">Todos los repartidores</option>
            @foreach (var repartidor in repartidores)
            {
                if (ViewBag.IdRepartidor != null
                    && (long)ViewBag.IdRepartidor == repartidor.Id)
                {
                    <option value="@repartidor.Id" selected>
                        @repartidor.Nombre
                    </option>
                }
                else
                {
                    <option value="@repartidor.Id">
                        @repartidor.Nombre
                    </option>
                }
            }
        </select>

        <input type="date"
               name="fecha"
               class="input-filter"
               value="@ViewBag.Fecha"
               aria-label="Filtrar por fecha" />

        <button type="submit" class="btn-apple">
            Filtrar
        </button>

        <a asp-action="Index"
           class="btn-apple"
           style="background:#f2f2f4;color:#1d1d1f;">
            Limpiar
        </a>
    </form>

    <div class="card-tabla">
        <div class="table-responsive">
            <table class="tabla-gastos">
                <thead>
                    <tr>
                        <th>Repartidor</th>
                        <th>Tipo</th>
                        <th>Monto</th>
                        <th>Fecha</th>
                        <th>Observación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="empty-row">
                                No hay gastos registrados para mostrar.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var gasto in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@gasto.Repartidor.Nombre</strong>
                                </td>
                                <td>
                                    <span class="badge-tipo">@gasto.Tipo</span>
                                </td>
                                <td class="monto-gasto">
                                    S/ @gasto.Monto.ToString("N2")
                                </td>
                                <td>
                                    @gasto.Fecha.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-muted-cell">
                                    @(string.IsNullOrWhiteSpace(gasto.Observacion)
                                        ? "—"
                                        : gasto.Observacion)
                                </td>
                                <td class="text-muted-cell">
                                    Pendiente
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="contador-gastos">
            Total de registros: @(Model?.Count ?? 0)
        </div>
    </div>


    <div class="modal fade" id="modalGasto" tabindex="-1"
         aria-labelledby="modalGastoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" id="contenidoModalGasto">
                <div class="modal-body text-center p-4">
                    Cargando formulario...
                </div>
            </div>
        </div>
    </div>

</div>



@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const botonNuevo = document.getElementById("btnNuevoGasto");
            const modalElemento = document.getElementById("modalGasto");
            const contenidoModal = document.getElementById("contenidoModalGasto");

            if (!botonNuevo || !modalElemento || !contenidoModal) {
                console.error("No se encontraron los elementos del modal de gastos.");
                return;
            }

            const modal = bootstrap.Modal.getOrCreateInstance(modalElemento);

            // Abrir el formulario de registro.
            botonNuevo.addEventListener("click", async function () {
                contenidoModal.innerHTML = `
                    <div class="modal-body text-center p-4">
                        Cargando formulario...
                    </div>`;

                modal.show();

                try {
                    const respuesta = await fetch("/Gastos/Create", {
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        }
                    });

                    if (!respuesta.ok) {
                        throw new Error(`Error HTTP ${respuesta.status}`);
                    }

                    contenidoModal.innerHTML = await respuesta.text();
                } catch (error) {
                    console.error(error);
                    contenidoModal.innerHTML = `
                        <div class="modal-body">
                            <p class="text-danger mb-0">
                                No se pudo cargar el formulario.
                            </p>
                        </div>`;
                }
            });

            // Interceptar el envío del formulario, incluso cuando se carga
            // dinámicamente dentro del modal.
            contenidoModal.addEventListener("submit", async function (evento) {
                const formulario = evento.target;

                if (!formulario.matches("#formCrearGasto")) {
                    return;
                }

                evento.preventDefault();

                const botonGuardar = formulario.querySelector(
                    'button[type="submit"]'
                );

                const textoOriginal = botonGuardar?.textContent;

                if (botonGuardar) {
                    botonGuardar.disabled = true;
                    botonGuardar.textContent = "Guardando...";
                }

                try {
                    const respuesta = await fetch(formulario.action, {
                        method: "POST",
                        body: new FormData(formulario),
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        }
                    });

                    const tipoContenido =
                        respuesta.headers.get("content-type") || "";

                    if (tipoContenido.includes("application/json")) {
                        const resultado = await respuesta.json();

                        if (!respuesta.ok || !resultado.success) {
                            throw new Error(
                                resultado.message || "No se pudo guardar el gasto."
                            );
                        }

                        modal.hide();

                        alert(resultado.message || "Gasto registrado correctamente.");

                        window.location.href =
                            resultado.redirectUrl || "/Gastos/Index";

                        return;
                    }

                    // Si el servidor devuelve el formulario, normalmente
                    // significa que existen errores de validación.
                    contenidoModal.innerHTML = await respuesta.text();
                } catch (error) {
                    console.error(error);

                    let mensaje = contenidoModal.querySelector(
                        "#errorEnvioGasto"
                    );

                    if (!mensaje) {
                        mensaje = document.createElement("div");
                        mensaje.id = "errorEnvioGasto";
                        mensaje.className = "alert alert-danger m-3";
                        contenidoModal.prepend(mensaje);
                    }

                    mensaje.textContent =
                        error.message || "Ocurrió un error al guardar el gasto.";
                } finally {
                    const botonActual = contenidoModal.querySelector(
                        '#formCrearGasto button[type="submit"]'
                    );

                    if (botonActual) {
                        botonActual.disabled = false;
                        botonActual.textContent =
                            textoOriginal || "Guardar gasto";
                    }
                }
            });
        });
    </script>
}


