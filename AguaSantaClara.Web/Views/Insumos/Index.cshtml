@model IEnumerable<AguaSantaClara.Web.Models.Entities.Insumo>

@{
    ViewData["Title"] = "Catálogo de insumos";
    var puedeAdministrar = User.IsInRole("Administradora") || User.IsInRole("Gerente");
}

<div class="container py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4 mb-1">Catálogo de insumos</h1>
            <p class="text-muted mb-0">Administra los insumos de embalaje.</p>
        </div>
        @if (puedeAdministrar)
        {
            <button type="button" class="btn btn-primary" id="btnNuevoInsumo">
                <i class="bi bi-plus-lg me-1"></i> Nuevo insumo
            </button>
        }
    </div>

    <!-- MENSAJES -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <!-- TABLA -->
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Insumo</th>
                    <th>Descripción</th>
                    <th>Costo</th>
                    <th>Estado</th>
                    @if (puedeAdministrar)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No hay insumos registrados.</td>
                </tr>
            }
            @foreach (var insumo in Model)
            {
                <tr>
                    <td><strong>@insumo.Nombre</strong></td>
                    <td>@(string.IsNullOrWhiteSpace(insumo.Descripcion) ? "—" : insumo.Descripcion)</td>
                    <td>S/ @insumo.Costo.ToString("0.00")</td>
                    <td>
                        @if (puedeAdministrar)
                        {
                            <select class="form-select form-select-sm" style="width:120px;"
                                    onchange="cambiarEstado(@insumo.Id, this.value)">
                                <option value="true" selected="@insumo.Estado">Activo</option>
                                <option value="false" selected="@(!insumo.Estado)">Inactivo</option>
                            </select>
                        }
                        else
                        {
                            <span class="badge @(insumo.Estado ? "text-bg-success" : "text-bg-secondary")">
                                @(insumo.Estado ? "Activo" : "Inactivo")
                            </span>
                        }
                    </td>
                    @if (puedeAdministrar)
                    {
                        <td>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        onclick="abrirModalEditar(@insumo.Id)">
                                    <i class="bi bi-pencil me-1"></i> Editar
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        onclick="confirmarEliminar(@insumo.Id, '@insumo.Nombre')">
                                    <i class="bi bi-trash me-1"></i> Eliminar
                                </button>
                            </div>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- FORM OCULTO CAMBIAR ESTADO -->
<form id="formCambiarEstado" asp-action="CambiarEstado" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="estadoId" />
    <input type="hidden" name="estado" id="estadoValor" />
</form>

<!-- FORM OCULTO ELIMINAR -->
<form id="formEliminar" asp-action="Delete" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="eliminarId" />
</form>

<!-- MODALES -->
@if (puedeAdministrar)
{
    <div class="modal fade" id="modalCrearInsumo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" id="contenidoModalCrear">
                <!-- Contenido cargado vía AJAX -->
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEditarInsumo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" id="contenidoModalEditar">
                <!-- Contenido cargado vía AJAX -->
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // ==================== ABRIR MODAL CREAR ====================
        document.addEventListener('DOMContentLoaded', function () {
            var btnNuevoInsumo = document.getElementById('btnNuevoInsumo');

            if (btnNuevoInsumo) {
                btnNuevoInsumo.addEventListener('click', function () {
                    fetch('/Insumos/Create')
                        .then(response => {
                            if (!response.ok) throw new Error('Error al cargar el formulario');
                            return response.text();
                        })
                        .then(html => {
                            document.getElementById('contenidoModalCrear').innerHTML = html;
                            var modal = new bootstrap.Modal(document.getElementById('modalCrearInsumo'));
                            modal.show();
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('No se pudo cargar el formulario de creación.');
                        });
                });
            }
        });

        // ==================== ABRIR MODAL EDITAR ====================
        function abrirModalEditar(id) {
            fetch('/Insumos/Edit/' + id)
                .then(response => {
                    if (!response.ok) throw new Error('Error al cargar el formulario');
                    return response.text();
                })
                .then(html => {
                    document.getElementById('contenidoModalEditar').innerHTML = html;
                    var modal = new bootstrap.Modal(document.getElementById('modalEditarInsumo'));
                    modal.show();
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('No se pudo cargar el formulario de edición.');
                });
        }

        // ==================== CAMBIAR ESTADO ====================
        function cambiarEstado(id, valor) {
            if (confirm('¿Está seguro de cambiar el estado de este insumo?')) {
                document.getElementById('estadoId').value = id;
                document.getElementById('estadoValor').value = valor;
                document.getElementById('formCambiarEstado').submit();
            } else {
                location.reload();
            }
        }

        // ==================== ELIMINAR ====================
        function confirmarEliminar(id, nombre) {
            if (confirm('¿Seguro eliminar el insumo "' + nombre + '"? Esta acción no se puede deshacer.')) {
                document.getElementById('eliminarId').value = id;
                document.getElementById('formEliminar').submit();
            }
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
}