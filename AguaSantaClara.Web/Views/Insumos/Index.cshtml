@model IEnumerable<AguaSantaClara.Web.Models.Entities.Insumo>

@{
    ViewData["Title"] = "Catálogo de insumos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 mb-1">Catálogo de insumos</h1>
        <p class="text-muted mb-0">Gestión de materiales usados en producción y distribución.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        + Crear insumo
    </a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-6 col-lg-4">
        <label for="search" class="visually-hidden">Buscar insumo</label>
        <input id="search"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Buscar insumo por nombre..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">
            Buscar
        </button>
    </div>
</form>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th class="text-end">Costo</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">
                            No hay insumos registrados.
                        </td>
                    </tr>
                }
                @foreach (var insumo in Model)
                {
                    <tr class="@(insumo.Estado ? "" : "table-secondary")">
                        <td><strong>@insumo.Nombre</strong></td>
                        <td class="text-muted">
                            @(string.IsNullOrWhiteSpace(insumo.Descripcion) ? "Sin descripción" : insumo.Descripcion)
                        </td>
                        <td class="text-end">S/ @insumo.Costo.ToString("0.00")</td>
                        <td class="text-center">
                            <span class="badge rounded-pill @(insumo.Estado ? "text-bg-success" : "text-bg-secondary")">
                                @(insumo.Estado ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="d-flex gap-1 justify-content-center">
                                <a asp-action="Edit" asp-route-id="@insumo.Id" class="btn btn-sm btn-outline-primary">
                                    Editar
                                </a>
                                @if (insumo.Estado)
                                {
                                    <form asp-action="Deactivate" asp-route-id="@insumo.Id" method="post"
                                          onsubmit="return confirm('¿Desactivar este insumo?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            Desactivar
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>