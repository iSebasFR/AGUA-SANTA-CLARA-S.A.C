@model IEnumerable<AguaSantaClara.Web.Models.Entities.Insumo>

@{
    ViewData["Title"] = "Catálogo de insumos";
    var puedeAdministrar = User.IsInRole("Administradora") || User.IsInRole("Gerente");
    var lineaActual = ViewBag.LineaFiltro as string;
}

<style>
    /* ============================================================
       FONDO CELESTE DESVANECIDO
       ============================================================ */
    body.app-body {
        background: linear-gradient(180deg, #eaf4fb 0%, #f0f7fc 40%, #fbfcfd 100%) !important;
        background-attachment: fixed !important;
    }

    .insumos-layout {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* ============================================================
       HEADER
       ============================================================ */
    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .panel-title {
        font-size: 20px;
        font-weight: 700;
        color: #1d1d1f;
        letter-spacing: -0.03em;
        margin: 0;
    }

    .panel-subtitle {
        font-size: 12.5px;
        color: #6e6e73;
        margin: 4px 0 0;
    }

    /* ============================================================
       BOTÓN NEGRO APPLE
       ============================================================ */
    .btn-apple {
        height: 36px;
        padding: 0 16px;
        background: #1d1d1f;
        color: #ffffff;
        border: none;
        border-radius: 9px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        text-decoration: none;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
    }

    .btn-apple:hover {
        background: #000000;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
    }

    .btn-apple:active {
        transform: translateY(0);
    }

    /* ============================================================
       TOOLBAR: FILTRO POR LÍNEA
       ============================================================ */
    .toolbar-row {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
        padding: 16px 20px;
        background: #ffffff;
        border: 1px solid #e5e5ea;
        border-radius: 14px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .select-filter {
        height: 36px;
        padding: 0 32px 0 12px;
        border: 1px solid #e5e5ea;
        border-radius: 9px;
        background: #fbfcfd;
        font-family: inherit;
        font-size: 12.5px;
        color: #1d1d1f;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        background-image: url("data:image/svg+xml,%3Csvg width='10' height='10' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 9l6 6 6-6' stroke='%236e6e73' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 10px center;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        min-width: 200px;
    }

    .select-filter:focus {
        outline: none;
        background-color: #ffffff;
        border-color: #1d1d1f;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
    }

    /* ============================================================
       TABLA
       ============================================================ */
    .card-tabla {
        background: #ffffff;
        border: 1px solid #e5e5ea;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .tabla-insumos {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

    .tabla-insumos thead th {
        text-align: left;
        padding: 14px 16px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 600;
        color: #6e6e73;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        background: #fbfcfd;
        border-bottom: 1px solid #e5e5ea;
        white-space: nowrap;
    }

    .tabla-insumos tbody td {
        padding: 16px;
        font-size: 13px;
        color: #1d1d1f;
        border-bottom: 1px solid #f0f0f2;
        vertical-align: middle;
    }

    .tabla-insumos tbody tr:last-child td {
        border-bottom: none;
    }

    .tabla-insumos tbody tr:hover {
        background: #fbfcfd;
    }

    .ins-name {
        font-weight: 600;
        color: #1d1d1f;
        font-size: 13px;
    }

    .badge-linea {
        display: inline-block;
        padding: 3px 10px;
        background: #eaf4fb;
        color: #3a8ab8;
        border-radius: 6px;
        font-size: 11.5px;
        font-weight: 600;
    }

    .text-muted-cell {
        color: #6e6e73;
        font-size: 12.5px;
    }

    /* ============================================================
       ESTADO DESPLEGABLE
       ============================================================ */
    .status-select {
        height: 30px;
        padding: 0 26px 0 10px;
        border-radius: 7px;
        border: 1px solid #e5e5ea;
        background-color: #ffffff;
        font-family: inherit;
        font-size: 11.5px;
        font-weight: 500;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        background-image: url("data:image/svg+xml,%3Csvg width='9' height='9' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 9l6 6 6-6' stroke='%236e6e73' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 8px center;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        width: 110px;
    }

    .status-select:focus {
        outline: none;
        border-color: #1d1d1f;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
    }

    .status-select.activo {
        background-color: #e8f9ee;
        border-color: #b8e6c6;
        color: #1a8a3a;
    }

    .status-select.inactivo {
        background-color: #f2f2f4;
        color: #6e6e73;
    }

    /* ============================================================
       BOTONES ACCIÓN
       ============================================================ */
    .acciones-tabla {
        display: inline-flex;
        gap: 6px;
    }

    .btn-tabla {
        height: 32px;
        padding: 0 14px;
        background: #ffffff;
        color: #1d1d1f;
        border: 1px solid #e5e5ea;
        border-radius: 8px;
        font-family: inherit;
        font-size: 12.5px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .btn-tabla:hover {
        background: #1d1d1f;
        color: #ffffff;
        border-color: #1d1d1f;
    }

    .btn-tabla.danger {
        color: #ff3b30;
        border-color: #ffd0cc;
    }

    .btn-tabla.danger:hover {
        background: #ff3b30;
        color: #ffffff;
        border-color: #ff3b30;
    }

    /* ============================================================
       EMPTY STATE
       ============================================================ */
    .empty-row {
        text-align: center;
        padding: 60px 20px;
        color: #6e6e73;
        font-size: 13px;
    }

    /* ============================================================
       TOASTS
       ============================================================ */
    .toast-container {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
        pointer-events: none;
    }

    .toast-custom {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: saturate(180%) blur(24px);
        -webkit-backdrop-filter: saturate(180%) blur(24px);
        border-radius: 14px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12), 0 0 0 0.5px rgba(0, 0, 0, 0.05);
        min-width: 300px;
        max-width: 380px;
        animation: toastIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        pointer-events: auto;
    }

    .toast-custom.success .toast-icon {
        background: #e8f9ee;
        color: #34c759;
    }

    .toast-custom.error .toast-icon {
        background: #ffebea;
        color: #ff3b30;
    }

    .toast-icon {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 16px;
        font-weight: 700;
    }

    .toast-content { flex: 1; }

    .toast-title {
        font-size: 13.5px;
        font-weight: 600;
        color: #1d1d1f;
    }

    .toast-msg {
        font-size: 12.5px;
        color: #6e6e73;
        margin-top: 1px;
    }

    .toast-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 2px;
        background: #34c759;
        animation: progress 3s linear forwards;
    }

    .toast-custom.error .toast-progress {
        background: #ff3b30;
    }

    @@keyframes toastIn {
        from { opacity: 0; transform: translateX(24px) scale(0.96); }
        to { opacity: 1; transform: translateX(0) scale(1); }
    }

    @@keyframes progress {
        from { width: 100%; }
        to { width: 0%; }
    }

    /* ============================================================
       MODAL DE CONFIRMACIÓN CUSTOM
       ============================================================ */
    .modal-backdrop-custom {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        animation: fadeInCustom 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .modal-backdrop-custom.show { display: flex; }

    @@keyframes fadeInCustom {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .modal-custom {
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.18), 0 0 0 0.5px rgba(0, 0, 0, 0.05);
        width: 100%;
        max-width: 400px;
        overflow: hidden;
        animation: modalInCustom 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @@keyframes modalInCustom {
        from { opacity: 0; transform: scale(0.92) translateY(15px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .modal-custom-body {
        padding: 32px 28px 8px;
        text-align: center;
    }

    .modal-custom-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #ffebea;
        color: #ff3b30;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-custom-icon.info { background: #eaf4fb; color: #3a8ab8; }
    .modal-custom-icon.success { background: #e8f9ee; color: #34c759; }

    .modal-custom-title {
        font-family: 'Inter', sans-serif;
        font-size: 18px;
        font-weight: 600;
        color: #1d1d1f;
        letter-spacing: -0.025em;
        margin: 0 0 8px;
    }

    .modal-custom-text {
        font-size: 13.5px;
        color: #6e6e73;
        line-height: 1.5;
        margin: 0;
    }

    .modal-custom-text strong { color: #1d1d1f; font-weight: 600; }

    .modal-custom-footer {
        padding: 24px;
        display: flex;
        gap: 10px;
    }

    .modal-custom-btn {
        flex: 1;
        height: 44px;
        border: none;
        border-radius: 11px;
        font-family: inherit;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .modal-custom-btn.secondary { background: #f2f2f4; color: #1d1d1f; }
    .modal-custom-btn.secondary:hover { background: #e8e8ea; }
    .modal-custom-btn.danger { background: #ff3b30; color: #ffffff; }
    .modal-custom-btn.danger:hover { background: #e02e25; }
    .modal-custom-btn.primary { background: #1d1d1f; color: #ffffff; }
    .modal-custom-btn.primary:hover { background: #000000; }
</style>

<div class="container py-4 insumos-layout">

    <!-- ==================== HEADER ==================== -->
    <div class="panel-header">
        <div>
            <h1 class="panel-title">Catálogo de insumos</h1>
            <p class="panel-subtitle">Administra los insumos de embalaje.</p>
        </div>
        @if (puedeAdministrar)
        {
            <button type="button" class="btn-apple" id="btnNuevoInsumo">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                Nuevo insumo
            </button>
        }
    </div>

    <!-- ==================== TOOLBAR ==================== -->
    <form method="get" asp-action="Index" class="toolbar-row">
        <select name="linea" class="select-filter">
            <option value="">Todas las líneas de producto</option>
            <option value="Agua" selected="@(lineaActual == "Agua")">Agua</option>
            <option value="PH" selected="@(lineaActual == "PH")">PH</option>
            <option value="Hielo" selected="@(lineaActual == "Hielo")">Hielo</option>
        </select>

        <select name="estado" class="select-filter">
            <option value="">Todos los estados</option>
            <option value="true" selected="@(ViewBag.EstadoFiltro as bool? == true)">Activos</option>
            <option value="false" selected="@(ViewBag.EstadoFiltro as bool? == false)">Inactivos</option>
        </select>

        <button type="submit" class="btn-apple">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.35-4.35"/>
            </svg>
            Filtrar
        </button>

        @if (!string.IsNullOrWhiteSpace(lineaActual) || ViewBag.EstadoFiltro != null)
        {
            <a asp-action="Index" class="btn-apple" style="background:#f2f2f4;color:#1d1d1f;">
                Limpiar
            </a>
        }
    </form>

    <!-- ==================== TABLA ==================== -->
    <div class="card-tabla">
        <div class="table-responsive">
            <table class="tabla-insumos">
                <thead>
                    <tr>
                        <th>Insumo</th>
                        <th>Línea</th>
                        <th>Descripción</th>
                        <th>Costo</th>
                        <th>Estado</th>
                        @if (puedeAdministrar)
                        {
                            <th>Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="empty-row">No hay insumos registrados.</td>
                    </tr>
                }
                @foreach (var insumo in Model)
                {
                    <tr>
                        <td><span class="ins-name">@insumo.Nombre</span></td>
                        <td><span class="badge-linea">@insumo.LineaProducto</span></td>
                        <td class="text-muted-cell">@(string.IsNullOrWhiteSpace(insumo.Descripcion) ? "—" : insumo.Descripcion)</td>
                        <td>S/ @insumo.Costo.ToString("0.00")</td>
                        <td>
                            @if (puedeAdministrar)
                            {
                                <select class="status-select @(insumo.Estado ? "activo" : "inactivo")"
                                        onchange="cambiarEstado(@insumo.Id, this.value, this)">
                                    <option value="true" selected="@insumo.Estado">Activo</option>
                                    <option value="false" selected="@(!insumo.Estado)">Inactivo</option>
                                </select>
                            }
                            else
                            {
                                <span class="badge-linea" style="background:@(insumo.Estado ? "#e8f9ee" : "#f2f2f4"); color:@(insumo.Estado ? "#1a8a3a" : "#6e6e73");">
                                    @(insumo.Estado ? "Activo" : "Inactivo")
                                </span>
                            }
                        </td>
                        @if (puedeAdministrar)
                        {
                            <td>
                                <div class="acciones-tabla">
                                    <button type="button" class="btn-tabla" onclick="abrirModalEditar(@insumo.Id)">
                                        Editar
                                    </button>
                                    <button type="button" class="btn-tabla danger" onclick="confirmarEliminar(@insumo.Id, '@insumo.Nombre')">
                                        Eliminar
                                    </button>
                                </div>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- ==================== FORMS OCULTOS ==================== -->
<form id="formCambiarEstado" asp-action="CambiarEstado" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="estadoId" />
    <input type="hidden" name="estado" id="estadoValor" />
</form>

<form id="formEliminar" asp-action="Delete" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="eliminarId" />
</form>

<!-- ==================== MODALES ==================== -->
@if (puedeAdministrar)
{
    <div class="modal fade" id="modalCrearInsumo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" id="contenidoModalCrear"></div>
        </div>
    </div>

    <div class="modal fade" id="modalEditarInsumo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" id="contenidoModalEditar"></div>
        </div>
    </div>
}

<!-- ==================== MODAL CONFIRMACIÓN CUSTOM ==================== -->
<div class="modal-backdrop-custom" id="modalConfirm">
    <div class="modal-custom">
        <div class="modal-custom-body">
            <div class="modal-custom-icon" id="modalConfirmIcon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 8v4M12 16h.01"/>
                </svg>
            </div>
            <h3 class="modal-custom-title" id="modalConfirmTitle">Confirmar acción</h3>
            <p class="modal-custom-text" id="modalConfirmText">¿Estás seguro de continuar?</p>
        </div>
        <div class="modal-custom-footer">
            <button type="button" class="modal-custom-btn secondary" onclick="cerrarModalConfirm()">Cancelar</button>
            <button type="button" class="modal-custom-btn danger" id="modalConfirmBtn">Confirmar</button>
        </div>
    </div>
</div>

<!-- ==================== TOASTS ==================== -->
<div class="toast-container" id="toastContainer"></div>

@section Scripts {
    <script>
        // ==================== ABRIR MODAL CREAR ====================
        document.addEventListener('DOMContentLoaded', function () {
            var btnNuevoInsumo = document.getElementById('btnNuevoInsumo');

            if (btnNuevoInsumo) {
                btnNuevoInsumo.addEventListener('click', function () {
                    fetch('/Insumos/Create')
                        .then(r => r.text())
                        .then(html => {
                            document.getElementById('contenidoModalCrear').innerHTML = html;
                            new bootstrap.Modal(document.getElementById('modalCrearInsumo')).show();
                        });
                });
            }
        });

        // ==================== ABRIR MODAL EDITAR ====================
        function abrirModalEditar(id) {
            fetch('/Insumos/Edit/' + id)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('contenidoModalEditar').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('modalEditarInsumo')).show();
                });
        }

        // ==================== MODAL DE CONFIRMACIÓN ====================
        let accionPendiente = null;

        function abrirModalConfirm(titulo, texto, tipo, callback, textoBoton) {
            const modal = document.getElementById('modalConfirm');
            const icon = document.getElementById('modalConfirmIcon');
            const title = document.getElementById('modalConfirmTitle');
            const text = document.getElementById('modalConfirmText');
            const btn = document.getElementById('modalConfirmBtn');

            icon.className = 'modal-custom-icon';
            if (tipo === 'danger') icon.classList.add('danger');
            else if (tipo === 'info') icon.classList.add('info');
            else if (tipo === 'success') icon.classList.add('success');

            title.textContent = titulo;
            text.innerHTML = texto;
            btn.textContent = textoBoton || 'Confirmar';
            btn.className = 'modal-custom-btn ' + (tipo === 'danger' ? 'danger' : 'primary');

            accionPendiente = callback;
            modal.classList.add('show');
        }

        function cerrarModalConfirm() {
            document.getElementById('modalConfirm').classList.remove('show');
            accionPendiente = null;
        }

        document.getElementById('modalConfirmBtn')?.addEventListener('click', function () {
            if (accionPendiente) {
                accionPendiente();
                accionPendiente = null;
            }
            cerrarModalConfirm();
        });

        document.getElementById('modalConfirm')?.addEventListener('click', function (e) {
            if (e.target === this) cerrarModalConfirm();
        });

        // ==================== CAMBIAR ESTADO ====================
        function cambiarEstado(id, valor, selectElement) {
            const estadoBool = valor === 'true';
            const accion = estadoBool ? 'activar' : 'desactivar';

            abrirModalConfirm(
                (estadoBool ? 'Activar' : 'Desactivar') + ' insumo',
                '¿Estás seguro de ' + accion + ' este insumo?',
                estadoBool ? 'success' : 'danger',
                function () {
                    document.getElementById('estadoId').value = id;
                    document.getElementById('estadoValor').value = valor;
                    document.getElementById('formCambiarEstado').submit();
                },
                estadoBool ? 'Activar' : 'Desactivar'
            );
        }

        // ==================== ELIMINAR ====================
        function confirmarEliminar(id, nombre) {
            abrirModalConfirm(
                'Eliminar insumo',
                '¿Seguro que deseas eliminar el insumo "<strong>' + nombre + '</strong>"? Esta acción no se puede deshacer.',
                'danger',
                function () {
                    document.getElementById('eliminarId').value = id;
                    document.getElementById('formEliminar').submit();
                },
                'Eliminar'
            );
        }

        // ==================== MOSTRAR TOAST ====================
        function mostrarToast(mensaje, tipo) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'toast-custom ' + (tipo || 'success');

            const icono = tipo === 'error' ? '!' : '✓';
            const titulo = tipo === 'error' ? 'Error' : 'Listo';

            toast.innerHTML = `
                <div class="toast-icon">${icono}</div>
                <div class="toast-content">
                    <div class="toast-title">${titulo}</div>
                    <div class="toast-msg">${mensaje}</div>
                </div>
                <div class="toast-progress"></div>
            `;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(24px) scale(0.96)';
                toast.style.transition = 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // ==================== MOSTRAR TOAST AL CARGAR ====================
        @if (TempData["SuccessMessage"] is string ok)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function () {
                mostrarToast('@ok', 'success');
            });
            </text>
        }
        @if (TempData["ErrorMessage"] is string err)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function () {
                mostrarToast('@err', 'error');
            });
            </text>
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
}