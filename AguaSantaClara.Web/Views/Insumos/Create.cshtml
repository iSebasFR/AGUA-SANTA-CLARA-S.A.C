@model AguaSantaClara.Web.Models.CrearInsumoViewModel

@{
    ViewData["Title"] = "Crear insumo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 mb-1">Crear insumo</h1>
        <p class="text-muted mb-0">Completa los datos para registrar el insumo.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        Volver
    </a>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" placeholder="Nombre del insumo" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Costo" class="form-label"></label>
            <input asp-for="Costo" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" />
            <span asp-validation-for="Costo" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción del insumo"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label class="form-label d-block">Estado</label>
            <div class="d-flex gap-4">
                <div class="form-check">
                    <input asp-for="Estado" class="form-check-input" type="radio" value="true" checked />
                    <label class="form-check-label">Activo</label>
                </div>
                <div class="form-check">
                    <input asp-for="Estado" class="form-check-input" type="radio" value="false" />
                    <label class="form-check-label">Inactivo</label>
                </div>
            </div>
            <span asp-validation-for="Estado" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">
            Guardar
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}