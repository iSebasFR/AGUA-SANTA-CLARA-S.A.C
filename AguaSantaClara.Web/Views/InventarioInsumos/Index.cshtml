
@using AguaSantaClara.Web.Models
@model IEnumerable<AguaSantaClara.Web.Models.Entities.Insumo>

@{
    ViewData["Title"] = "Inventario de insumos";
}

<link rel="stylesheet" href="~/css/inventario-insumos.css" asp-append-version="true" />

<div class="container py-4 inv-layout">

    <div>
        <h1 class="panel-title">Inventario de insumos</h1>
        <p class="panel-subtitle">Consulta y actualiza el stock de insumos de embalaje.</p>
    </div>

    <div class="card-tabla">
        <div class="table-responsive">
            <table class="tabla-insumos">
                <thead>
                    <tr>
                        <th>Insumo</th>
                        <th>Línea de producto</th>
                        <th>Stock actual</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="empty-row">No hay insumos registrados en el catálogo.</td></tr>
                }
                @foreach (var insumo in Model)
                {
                    <tr data-insumo-id="@insumo.Id">
                        <td><span class="ins-name">@insumo.Nombre</span></td>
                        <td><span class="badge-linea">@insumo.LineaProducto</span></td>
                        <td>
                            <span class="stock-badge @StockInsumoHelper.ClaseCss(insumo.StockActual, insumo.StockMinimo)" data-stock>@insumo.StockActual unid.</span>
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn-tabla btn-modificar" data-id="@insumo.Id">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                                Modificar cantidad
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalModificarStock" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="contenidoModalStock"></div>
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>

@section Scripts {
    <script src="~/js/inventario-insumos.js" asp-append-version="true"></script>
}