@model AguaSantaClara.Web.Models.Entities.Cliente

@{
    ViewData["Title"] = "Ficha del cliente";
    var successMessage = TempData["SuccessMessage"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1">Ficha del cliente</h2>
        <p class="text-muted mb-0">Datos y direcciones de entrega.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver a clientes</a>
</div>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

<dl class="row">
    <dt class="col-sm-3">Nombre / Razón social</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>
    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@Model.Telefono</dd>
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@(Model.Estado ? "Activo" : "Inactivo")</dd>
</dl>

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h3 class="h5 mb-0">Direcciones de entrega</h3>
    @if (User.IsInRole("Vendedora"))
    {
        <a asp-action="AddAddress" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Agregar dirección
        </a>
    }
</div>
@if (Model.Direcciones.Any())
{
    <ul class="list-group mb-4">
        @foreach (var direccion in Model.Direcciones.OrderByDescending(direccion => direccion.Principal))
        {
            <li class="list-group-item d-flex justify-content-between align-items-start gap-3">
                <div>
                    @if (direccion.Principal)
                    {
                        <span class="badge text-bg-primary me-2">Principal</span>
                    }
                    @direccion.Direccion
                    @if (!string.IsNullOrWhiteSpace(direccion.Ciudad))
                    {
                        <span>, @direccion.Ciudad</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(direccion.Referencia))
                    {
                        <div class="text-muted small">@direccion.Referencia</div>
                    }
                </div>
                @if (User.IsInRole("Vendedora"))
                {
                    <div class="d-flex gap-2 flex-shrink-0">
                        <a asp-action="EditAddress" asp-route-id="@direccion.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        @if (!direccion.Principal)
                        {
                            <form asp-action="SetPrimaryAddress" method="post">
                                <input type="hidden" name="id" value="@direccion.Id" />
                                <input type="hidden" name="clienteId" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Marcar principal</button>
                            </form>
                        }
                    </div>
                }
            </li>
        }
    </ul>
}
else
{
    <p class="text-muted">El cliente aún no tiene direcciones registradas.</p>
}

@if (User.IsInRole("Vendedora"))
{
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar ficha</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Eliminar cliente</a>
    </div>
}