@model AguaSantaClara.Web.Models.Entities.Cliente
@using AguaSantaClara.Web.Models.Entities

@{
    ViewData["Title"] = "Ficha del cliente";
    var pedidos = ViewBag.Pedidos as List<Pedido> ?? new List<Pedido>();
    var puedeEditar = User.IsInRole("Vendedora") || User.IsInRole("Gerente") || User.IsInRole("Administradora");
    var puedeAgregarDir = User.IsInRole("Vendedora");
}

<div class="container py-4">

    <!-- VOLVER -->
    <a asp-action="Index" class="btn btn-link text-decoration-none mb-3 ps-0">
        <i class="bi bi-arrow-left me-1"></i> Volver al listado
    </a>

    <!-- MENSAJES -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <!-- HEADER -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h1 class="h4 mb-0">@Model.Nombre</h1>
                        <span class="badge @(Model.Estado ? "text-bg-success" : "text-bg-secondary")">
                            @(Model.Estado ? "Activo" : "Inactivo")
                        </span>
                    </div>
                    <div class="text-muted small">
                        <span>DNI: @(string.IsNullOrWhiteSpace(Model.Dni) ? "—" : Model.Dni)</span>
                        <span class="mx-2">·</span>
                        <span>Teléfono: @Model.Telefono</span>
                        <span class="mx-2">·</span>
                        <span>Cliente desde: @Model.FechaCreacion.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
                @if (puedeEditar)
                {
                    <button type="button" class="btn btn-outline-primary"
                            data-bs-toggle="modal" data-bs-target="#editarClienteModal">
                        <i class="bi bi-pencil me-1"></i> Editar cliente
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- TABS -->
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-info" type="button">
                Información general
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-direcciones" type="button">
                Direcciones <span class="badge text-bg-secondary ms-1">@Model.Direcciones.Count</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-historial" type="button">
                Historial de pedidos <span class="badge text-bg-secondary ms-1">@pedidos.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom p-4 bg-white">

        <!-- TAB: INFO -->
        <div class="tab-pane fade show active" id="tab-info">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="text-muted small d-block">Nombre / Razón social</label>
                    <div class="fw-semibold">@Model.Nombre</div>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small d-block">DNI</label>
                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Dni) ? "—" : Model.Dni)</div>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small d-block">Teléfono</label>
                    <div class="fw-semibold">@Model.Telefono</div>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small d-block">Saldo de bidones</label>
                    <div class="fw-semibold">@Model.SaldoBidones</div>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small d-block">Deuda total</label>
                    <div class="fw-semibold">S/ @Model.DeudaTotal.ToString("0.00")</div>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small d-block">Estado</label>
                    <div class="fw-semibold">@(Model.Estado ? "Activo" : "Inactivo")</div>
                </div>
            </div>
        </div>

        <!-- TAB: DIRECCIONES -->
        <div class="tab-pane fade" id="tab-direcciones">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0">Direcciones de entrega</h6>
                @if (puedeAgregarDir)
                {
                    <button type="button" class="btn btn-primary btn-sm"
                            onclick="abrirModalAgregarDireccion()">
                        <i class="bi bi-plus-lg me-1"></i> Agregar dirección
                    </button>
                }
            </div>

            @if (!Model.Direcciones.Any())
            {
                <p class="text-muted mb-0">Este cliente aún no tiene direcciones registradas.</p>
            }
            else
            {
                <div class="d-grid gap-2">
                    @foreach (var d in Model.Direcciones.OrderByDescending(x => x.Principal))
                    {
                        <div class="border rounded p-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <strong>@d.Direccion</strong>
                                        @if (d.Principal)
                                        {
                                            <span class="badge text-bg-primary">Principal</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(d.Ciudad))
                                    {
                                        <div class="text-muted small">Ciudad: @d.Ciudad</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(d.Referencia))
                                    {
                                        <div class="text-muted small">Ref: @d.Referencia</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(d.UrlUbicacion))
                                    {
                                        <a href="@d.UrlUbicacion" target="_blank" rel="noopener noreferrer" class="small">
                                            <i class="bi bi-geo"></i> Ver ubicación
                                        </a>
                                    }
                                </div>
                                @if (puedeAgregarDir)
                                {
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                onclick="abrirModalEditarDireccion(@d.Id)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (!d.Principal)
                                        {
                                            <form asp-action="SetPrimaryAddress" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@d.Id" />
                                                <input type="hidden" name="clienteId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                        title="Marcar como principal">
                                                    <i class="bi bi-star"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (Model.Direcciones.Count > 1)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    onclick="confirmarEliminarDireccion(@d.Id, '@d.Direccion')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- TAB: HISTORIAL -->
        <div class="tab-pane fade" id="tab-historial">
            @if (!pedidos.Any())
            {
                <p class="text-muted mb-0">Este cliente aún no tiene pedidos registrados.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>N°</th>
                                <th>Fecha</th>
                                <th>Local</th>
                                <th>Repartidor</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pedido in pedidos)
                            {
                                <tr>
                                    <td>#@pedido.Id</td>
                                    <td>@pedido.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                    <td>@(pedido.Local?.Nombre ?? "-")</td>
                                    <td>@(pedido.Repartidor?.Nombre ?? "—")</td>
                                    <td class="text-end">S/ @pedido.Total.ToString("0.00")</td>
                                    <td class="text-center">
                                        <span class="badge text-bg-info">@pedido.Estado</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- MODAL EDITAR CLIENTE -->
@if (puedeEditar)
{
    <div class="modal fade" id="editarClienteModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" id="contenidoModalEditar"></div>
        </div>
    </div>
}

<!-- MODAL AGREGAR DIRECCIÓN -->
@if (puedeAgregarDir)
{
    <div class="modal fade" id="modalAgregarDireccion" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" id="contenidoModalAgregarDireccion"></div>
        </div>
    </div>

    <div class="modal fade" id="modalEditarDireccion" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" id="contenidoModalEditarDireccion"></div>
        </div>
    </div>

    <form id="formEliminarDireccion" asp-action="DeleteAddress" method="post" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="eliminarDireccionId" />
        <input type="hidden" name="clienteId" value="@Model.Id" />
    </form>
}

@section Scripts {
    <script>
        function abrirModalEditarCliente(id) {
            fetch('/Clientes/Edit/' + id)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('contenidoModalEditar').innerHTML = html;
                    var modal = new bootstrap.Modal(document.getElementById('editarClienteModal'));
                    modal.show();
                });
        }

        document.querySelectorAll('[data-bs-target="#editarClienteModal"]').forEach(btn => {
            btn.addEventListener('click', function () {
                abrirModalEditarCliente(@Model.Id);
            });
        });

        function abrirModalAgregarDireccion() {
            fetch('/Clientes/AddAddress/@Model.Id')
                .then(response => response.text())
                .then(html => {
                    document.getElementById('contenidoModalAgregarDireccion').innerHTML = html;
                    var modal = new bootstrap.Modal(document.getElementById('modalAgregarDireccion'));
                    modal.show();
                });
        }

        function abrirModalEditarDireccion(id) {
            fetch('/Clientes/EditAddress/' + id)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('contenidoModalEditarDireccion').innerHTML = html;
                    var modal = new bootstrap.Modal(document.getElementById('modalEditarDireccion'));
                    modal.show();
                });
        }

        function confirmarEliminarDireccion(id, direccion) {
            if (confirm('¿Seguro eliminar la dirección "' + direccion + '"?')) {
                document.getElementById('eliminarDireccionId').value = id;
                document.getElementById('formEliminarDireccion').submit();
            }
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
}