@model AguaSantaClara.Web.Models.DireccionClienteViewModel

@{
    ViewData["Title"] = "Editar dirección";
}

<div class="mb-4">
    <h2 class="h4 mb-1">Editar dirección de entrega</h2>
    <p class="text-muted mb-0">Actualiza los datos de esta dirección.</p>
</div>

<form asp-action="EditAddress" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IdCliente" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Direccion" class="form-label"></label>
            <input asp-for="Direccion" class="form-control" autocomplete="street-address" />
            <span asp-validation-for="Direccion" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Ciudad" class="form-label"></label>
            <input asp-for="Ciudad" class="form-control" autocomplete="address-level2" />
            <span asp-validation-for="Ciudad" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Referencia" class="form-label"></label>
            <input asp-for="Referencia" class="form-control" />
            <span asp-validation-for="Referencia" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="UrlUbicacion" class="form-label"></label>
            <input asp-for="UrlUbicacion" class="form-control" inputmode="url" />
            <span asp-validation-for="UrlUbicacion" class="text-danger"></span>
        </div>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Details" asp-route-id="@Model.IdCliente" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}