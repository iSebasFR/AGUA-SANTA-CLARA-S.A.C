@model IEnumerable<AguaSantaClara.Web.Models.Entities.Cliente>

@{
    ViewData["Title"] = "Clientes";
    var successMessage = TempData["SuccessMessage"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1">Clientes</h2>
        <p class="text-muted mb-0">Gestión de clientes.</p>
    </div>
    @if (User.IsInRole("Vendedora"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Crear cliente
        </a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Buscar por nombre o teléfono" aria-label="Buscar clientes por nombre o teléfono" />
        <button type="submit" class="btn btn-outline-primary">
            <i class="bi bi-search me-1"></i> Buscar
        </button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre / Razón social</th>
                <th>Teléfono</th>
                <th>Dirección principal</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@cliente.Id">@cliente.Nombre</a></td>
                        <td>@cliente.Telefono</td>
                        <td>@(cliente.Direcciones.FirstOrDefault(direccion => direccion.Principal)?.Direccion ?? cliente.Direcciones.FirstOrDefault()?.Direccion ?? "-")</td>
                        <td>@(cliente.Estado ? "Activo" : "Inactivo")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">No hay clientes registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>