@model AguaSantaClara.Web.Models.ClientesIndexViewModel

@{
    ViewData["Title"] = "Clientes";
    var puedeCrear = User.IsInRole("Vendedora");
    var puedeAdministrar = User.IsInRole("Vendedora") || User.IsInRole("Gerente") || User.IsInRole("Administradora");
}

<div class="container py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4 mb-1">Clientes</h1>
            <p class="text-muted mb-0">Gestión de clientes y direcciones de entrega.</p>
        </div>
        @if (puedeCrear)
        {
            <button type="button" class="btn btn-primary" id="btnNuevoCliente">
                <i class="bi bi-plus-lg me-1"></i> Crear cliente
            </button>
        }
    </div>

    <!-- MENSAJES -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <!-- FILTROS -->
    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-6">
            <input name="search" value="@Model.Search" class="form-control"
                   placeholder="Buscar por nombre, DNI o teléfono" />
        </div>
        <div class="col-md-3">
            <select name="estado" class="form-select" asp-items="Model.Estados"
                    asp-for="EstadoFiltro">
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-outline-primary w-100">
                <i class="bi bi-search me-1"></i> Filtrar
            </button>
        </div>
    </form>

    <!-- TABLA -->
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>DNI</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    @if (puedeAdministrar)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
            @if (!Model.Clientes.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No se encontraron clientes.</td>
                </tr>
            }
            @foreach (var cliente in Model.Clientes)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@cliente.Id" class="fw-semibold text-decoration-none">
                            @cliente.Nombre
                        </a>
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(cliente.Dni) ? "—" : cliente.Dni)</td>
                    <td>@cliente.Telefono</td>
                    <td>
                        @if (puedeAdministrar)
                        {
                            <select class="form-select form-select-sm" style="width:120px;"
                                    onchange="cambiarEstado(@cliente.Id, this.value)">
                                <option value="true" selected="@cliente.Estado">Activo</option>
                                <option value="false" selected="@(!cliente.Estado)">Inactivo</option>
                            </select>
                        }
                        else
                        {
                            <span class="badge @(cliente.Estado ? "text-bg-success" : "text-bg-secondary")">
                                @(cliente.Estado ? "Activo" : "Inactivo")
                            </span>
                        }
                    </td>
                    @if (puedeAdministrar)
                    {
                        <td>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        onclick="abrirModalEditar(@cliente.Id)">
                                    <i class="bi bi-pencil me-1"></i> Editar
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        onclick="confirmarEliminar(@cliente.Id, '@cliente.Nombre')">
                                    <i class="bi bi-trash me-1"></i> Eliminar
                                </button>
                            </div>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- FORM OCULTO CAMBIAR ESTADO -->
<form id="formCambiarEstado" asp-action="CambiarEstado" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="estadoId" />
    <input type="hidden" name="estado" id="estadoValor" />
</form>

<!-- FORM OCULTO ELIMINAR -->
<form id="formEliminar" asp-action="Delete" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="eliminarId" />
</form>

<!-- MODALES -->
@if (puedeCrear)
{
    <div class="modal fade" id="modalCrearCliente" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" id="contenidoModalCrear"></div>
        </div>
    </div>
}

@if (puedeAdministrar)
{
    <div class="modal fade" id="modalEditarCliente" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" id="contenidoModalEditar"></div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var btnNuevoCliente = document.getElementById('btnNuevoCliente');

            if (btnNuevoCliente) {
                btnNuevoCliente.addEventListener('click', function () {
                    fetch('/Clientes/Create')
                        .then(response => response.text())
                        .then(html => {
                            document.getElementById('contenidoModalCrear').innerHTML = html;
                            var modal = new bootstrap.Modal(document.getElementById('modalCrearCliente'));
                            modal.show();
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('No se pudo cargar el formulario de creación.');
                        });
                });
            }
        });

        function abrirModalEditar(id) {
            fetch('/Clientes/Edit/' + id)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('contenidoModalEditar').innerHTML = html;
                    var modal = new bootstrap.Modal(document.getElementById('modalEditarCliente'));
                    modal.show();
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('No se pudo cargar el formulario de edición.');
                });
        }

        function cambiarEstado(id, valor) {
            if (confirm('¿Está seguro de cambiar el estado de este cliente?')) {
                document.getElementById('estadoId').value = id;
                document.getElementById('estadoValor').value = valor;
                document.getElementById('formCambiarEstado').submit();
            } else {
                location.reload();
            }
        }

        function confirmarEliminar(id, nombre) {
            if (confirm('¿Seguro eliminar al cliente "' + nombre + '"? Esta acción no se puede deshacer.')) {
                document.getElementById('eliminarId').value = id;
                document.getElementById('formEliminar').submit();
            }
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
}