@model AguaSantaClara.Web.Models.EditarUsuarioViewModel

@{
    ViewData["Title"] = "Detalle del usuario";
}

<style>
    body.app-body {
        background: linear-gradient(180deg, #eaf4fb 0%, #f0f7fc 40%, #fbfcfd 100%) !important;
        background-attachment: fixed !important;
    }

    .form-page {
        max-width: 720px;
        margin: 0 auto;
        background: #ffffff;
        border: 1px solid #e5e5ea;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
    }

    .form-page-title {
        font-size: 22px;
        font-weight: 700;
        color: #1d1d1f;
        letter-spacing: -0.03em;
        margin: 0 0 6px;
    }

    .form-page-subtitle {
        font-size: 13px;
        color: #6e6e73;
        margin: 0 0 28px;
    }

    .form-label {
        font-size: 12.5px;
        font-weight: 500;
        color: #6e6e73;
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        height: 42px;
        border: 1px solid #e5e5ea;
        border-radius: 9px;
        font-size: 13.5px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .form-control:focus, .form-select:focus {
        border-color: #1d1d1f;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
    }

    .btn-apple {
        height: 42px;
        padding: 0 20px;
        background: #1d1d1f;
        color: #ffffff;
        border: none;
        border-radius: 10px;
        font-family: inherit;
        font-size: 13.5px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
    }

    .btn-apple:hover {
        background: #000000;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
    }

    .badge-info {
        display: inline-block;
        padding: 4px 12px;
        background: #eaf4fb;
        color: #3a8ab8;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
    }

    .permiso-chip {
        display: inline-block;
        padding: 4px 12px;
        background: #fbfcfd;
        border: 1px solid #e5e5ea;
        border-radius: 7px;
        font-size: 12px;
        color: #1d1d1f;
        font-weight: 500;
    }
</style>

<div class="container py-4">
    <div class="form-page">

        <h1 class="form-page-title">Detalle del usuario</h1>
        <p class="form-page-subtitle">Consulta y modifica los datos del usuario seleccionado.</p>

        <form asp-action="Edit" method="post">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="UserName" class="form-label">Usuario</label>
                    <input asp-for="UserName" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Nombres" class="form-label">Nombres</label>
                    <input asp-for="Nombres" class="form-control" />
                    <span asp-validation-for="Nombres" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Apellidos" class="form-label">Apellidos</label>
                    <input asp-for="Apellidos" class="form-control" />
                    <span asp-validation-for="Apellidos" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="IdRol" class="form-label">Rol</label>
                    <select asp-for="IdRol" asp-items="Model.Roles" class="form-select"></select>
                    <span asp-validation-for="IdRol" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Estado</label>
                    <p style="font-size:13.5px; font-weight:500; color:#1d1d1f; margin:0; padding-top:10px;">
                        @(Model.Estado ? "Activo" : "Inactivo")
                    </p>
                </div>
            </div>

            <hr style="margin: 32px 0; border-color:#e5e5ea;" />

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Rol asignado</label>
                    <div><span class="badge-info">@Model.NombreRol</span></div>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Permisos del rol</label>
                    @if (Model.Permisos.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var permiso in Model.Permisos)
                            {
                                <span class="permiso-chip">@permiso</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p style="font-size:13px; color:#6e6e73; margin:0;">Sin permisos asignados.</p>
                    }
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn-apple">Guardar cambios</button>
                <a asp-action="Index" class="btn-apple secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}