@model AguaSantaClara.Web.Models.CrearUsuarioViewModel

@{
    ViewData["Title"] = "Crear usuario";
}

<style>
    body.app-body {
        background: linear-gradient(180deg, #eaf4fb 0%, #f0f7fc 40%, #fbfcfd 100%) !important;
        background-attachment: fixed !important;
    }

    .form-page {
        max-width: 720px;
        margin: 0 auto;
        background: #ffffff;
        border: 1px solid #e5e5ea;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
    }

    .form-page-title {
        font-size: 22px;
        font-weight: 700;
        color: #1d1d1f;
        letter-spacing: -0.03em;
        margin: 0 0 6px;
    }

    .form-page-subtitle {
        font-size: 13px;
        color: #6e6e73;
        margin: 0 0 28px;
    }

    .form-label {
        font-size: 12.5px;
        font-weight: 500;
        color: #6e6e73;
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        height: 42px;
        border: 1px solid #e5e5ea;
        border-radius: 9px;
        font-size: 13.5px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .form-control:focus, .form-select:focus {
        border-color: #1d1d1f;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
    }

    .btn-apple {
        height: 42px;
        padding: 0 20px;
        background: #1d1d1f;
        color: #ffffff;
        border: none;
        border-radius: 10px;
        font-family: inherit;
        font-size: 13.5px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
    }

    .btn-apple:hover {
        background: #000000;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
    }

    .btn-apple.secondary {
        background: #f2f2f4;
        color: #1d1d1f;
        box-shadow: none;
    }

    .btn-apple.secondary:hover {
        background: #e8e8ea;
        color: #1d1d1f;
    }
</style>

<div class="container py-4">
    <div class="form-page">

        <h1 class="form-page-title">Crear usuario</h1>
        <p class="form-page-subtitle">Ingresa los datos del usuario y selecciona su rol.</p>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Nombres" class="form-label">Nombres</label>
                    <input asp-for="Nombres" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="Nombres" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Apellidos" class="form-label">Apellidos</label>
                    <input asp-for="Apellidos" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="Apellidos" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="UserName" class="form-label">Usuario</label>
                    <input asp-for="UserName" class="form-control" autocomplete="username" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="IdRol" class="form-label">Rol</label>
                    <select asp-for="IdRol" asp-items="Model.Roles" class="form-select">
                        <option value="">Seleccione un rol</option>
                    </select>
                    <span asp-validation-for="IdRol" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn-apple">Guardar</button>
                <a asp-action="Index" class="btn-apple secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}