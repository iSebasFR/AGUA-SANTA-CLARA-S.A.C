@model AguaSantaClara.Web.Models.UsuariosIndexViewModel

@{
    ViewData["Title"] = "Usuarios";
}

<h1>Usuarios</h1>
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Administra los usuarios y sus roles de acceso.</p>
    @if (User.IsInRole("Gerente"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Crear usuario
        </a>
    }
</div>

<!-- FILTROS -->
<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input name="search" value="@Model.Search" class="form-control"
               placeholder="Buscar por usuario o nombre" />
    </div>
    <div class="col-md-3">
        <select name="idRol" class="form-select" asp-items="Model.Roles">
            <option value="">Todos los roles</option>
        </select>
    </div>
    <div class="col-md-3">
        <select name="estado" class="form-select" asp-items="Model.Estados">
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">
            <i class="bi bi-search me-1"></i> Filtrar
        </button>
    </div>
</form>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<!-- TABLA -->
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre completo</th>
                <th>Usuario</th>
                <th>Rol</th>
                <th>Contraseña</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Usuarios.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-4">No se encontraron usuarios.</td>
            </tr>
        }
        @foreach (var usuario in Model.Usuarios)
        {
            <tr>
                <td>@usuario.Nombres @usuario.Apellidos</td>
                <td>@usuario.UserName</td>
                <td>@(usuario.Rol?.Codigo == "ADMIN" ? "Administrador" : usuario.Rol?.Codigo == "VENDEDORA" ? "Vendedor" : usuario.Rol?.Name)</td>
                <td>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            onclick="abrirModalRestablecer(@usuario.Id, '@usuario.UserName')">
                        <i class="bi bi-key me-1"></i> Restablecer
                    </button>
                </td>
                <td>
                    <select class="form-select form-select-sm" style="width:120px;"
                            onchange="cambiarEstado(@usuario.Id, this.value)">
                        <option value="true" selected="@usuario.Estado">Activo</option>
                        <option value="false" selected="@(!usuario.Estado)">Inactivo</option>
                    </select>
                </td>
                <td>
                    <div class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil me-1"></i> Editar
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                onclick="confirmarEliminar(@usuario.Id, '@usuario.Nombres @usuario.Apellidos')">
                            <i class="bi bi-trash me-1"></i> Eliminar
                        </button>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<!-- FORM OCULTO PARA CAMBIAR ESTADO -->
<form id="formCambiarEstado" asp-action="CambiarEstado" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="estadoId" />
    <input type="hidden" name="estado" id="estadoValor" />
</form>

<!-- FORM OCULTO PARA ELIMINAR -->
<form id="formEliminar" asp-action="Eliminar" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="eliminarId" />
</form>

<!-- MODAL RESTABLECER CONTRASEÑA -->
<div class="modal fade" id="modalRestablecer" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RestablecerPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Restablecer contraseña</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="restablecerId" />
                    <p>Usuario: <strong id="restablecerUsuario"></strong></p>
                    <div class="mb-3">
                        <label class="form-label">Nueva contraseña</label>
                        <input type="password" name="NuevaPassword" class="form-control" minlength="8" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirmar contraseña</label>
                        <input type="password" name="ConfirmarPassword" class="form-control" minlength="8" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Restablecer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function cambiarEstado(id, valor) {
            if (confirm('¿Está seguro de cambiar el estado de este usuario?')) {
                document.getElementById('estadoId').value = id;
                document.getElementById('estadoValor').value = valor;
                document.getElementById('formCambiarEstado').submit();
            } else {
                location.reload();
            }
        }

        function confirmarEliminar(id, nombre) {
            if (confirm('¿Seguro eliminar al usuario "' + nombre + '"? Esta acción no se puede deshacer.')) {
                document.getElementById('eliminarId').value = id;
                document.getElementById('formEliminar').submit();
            }
        }

        function abrirModalRestablecer(id, userName) {
            document.getElementById('restablecerId').value = id;
            document.getElementById('restablecerUsuario').textContent = userName;
            var modal = new bootstrap.Modal(document.getElementById('modalRestablecer'));
            modal.show();
        }
    </script>
}