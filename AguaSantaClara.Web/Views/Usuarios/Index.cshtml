@model AguaSantaClara.Web.Models.UsuariosIndexViewModel

@{
    ViewData["Title"] = "Usuarios";
    var puedeCrear = User.IsInRole("Gerente");
    var estadoActual = Model.EstadoFiltro;
    var rolActual = Model.IdRolFiltro;
}

<style>
    /* ============================================================
       FONDO CELESTE DESVANECIDO
       ============================================================ */
    body.app-body {
        background: linear-gradient(180deg, #eaf4fb 0%, #f0f7fc 40%, #fbfcfd 100%) !important;
        background-attachment: fixed !important;
    }

    .usuarios-layout {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* ============================================================
       HEADER
       ============================================================ */
    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .panel-title {
        font-size: 20px;
        font-weight: 700;
        color: #1d1d1f;
        letter-spacing: -0.03em;
        margin: 0;
    }

    .panel-subtitle {
        font-size: 12.5px;
        color: #6e6e73;
        margin: 4px 0 0;
    }

    /* ============================================================
       BOTÓN NEGRO APPLE
       ============================================================ */
    .btn-apple {
        height: 36px;
        padding: 0 16px;
        background: #1d1d1f;
        color: #ffffff;
        border: none;
        border-radius: 9px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        text-decoration: none;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
    }

    .btn-apple:hover {
        background: #000000;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
    }

    .btn-apple:active {
        transform: translateY(0);
    }

    .btn-apple.secondary {
        background: #f2f2f4;
        color: #1d1d1f;
        box-shadow: none;
    }

    .btn-apple.secondary:hover {
        background: #e8e8ea;
        color: #1d1d1f;
        box-shadow: none;
    }

    /* ============================================================
       TOOLBAR
       ============================================================ */
    .toolbar-row {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
        padding: 16px 20px;
        background: #ffffff;
        border: 1px solid #e5e5ea;
        border-radius: 14px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .search-box {
        position: relative;
        flex: 1;
        min-width: 200px;
    }

    .search-box input {
        width: 100%;
        height: 36px;
        padding: 0 14px 0 36px;
        border: 1px solid #e5e5ea;
        border-radius: 9px;
        background: #fbfcfd;
        font-family: inherit;
        font-size: 12.5px;
        color: #1d1d1f;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .search-box input::placeholder { color: #a1a1a6; }

    .search-box input:focus {
        outline: none;
        background: #ffffff;
        border-color: #1d1d1f;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
    }

    .search-box svg {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #a1a1a6;
        pointer-events: none;
    }

    .select-filter {
        height: 36px;
        padding: 0 32px 0 12px;
        border: 1px solid #e5e5ea;
        border-radius: 9px;
        background: #fbfcfd;
        font-family: inherit;
        font-size: 12.5px;
        color: #1d1d1f;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        background-image: url("data:image/svg+xml,%3Csvg width='10' height='10' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 9l6 6 6-6' stroke='%236e6e73' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 10px center;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        min-width: 140px;
    }

    .select-filter:focus {
        outline: none;
        background-color: #ffffff;
        border-color: #1d1d1f;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
    }

    /* ============================================================
       TABLA
       ============================================================ */
    .card-tabla {
        background: #ffffff;
        border: 1px solid #e5e5ea;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .tabla-usuarios {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

    .tabla-usuarios thead th {
        text-align: left;
        padding: 14px 16px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 600;
        color: #6e6e73;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        background: #fbfcfd;
        border-bottom: 1px solid #e5e5ea;
        white-space: nowrap;
    }

    .tabla-usuarios tbody td {
        padding: 16px;
        font-size: 13px;
        color: #1d1d1f;
        border-bottom: 1px solid #f0f0f2;
        vertical-align: middle;
    }

    .tabla-usuarios tbody tr:last-child td { border-bottom: none; }
    .tabla-usuarios tbody tr:hover { background: #fbfcfd; }

    .user-name {
        font-weight: 600;
        color: #1d1d1f;
        font-size: 13px;
    }

    .user-username {
        font-size: 12px;
        color: #6e6e73;
        margin-top: 2px;
    }

    .badge-rol {
        display: inline-block;
        padding: 3px 10px;
        background: #eaf4fb;
        color: #3a8ab8;
        border-radius: 6px;
        font-size: 11.5px;
        font-weight: 600;
    }

    .badge-rol.admin { background: #f3e8ff; color: #7c3aed; }
    .badge-rol.vendedor { background: #eaf4fb; color: #3a8ab8; }

    /* ============================================================
       ESTADO DESPLEGABLE
       ============================================================ */
    .status-select {
        height: 30px;
        padding: 0 26px 0 10px;
        border-radius: 7px;
        border: 1px solid #e5e5ea;
        background-color: #ffffff;
        font-family: inherit;
        font-size: 11.5px;
        font-weight: 500;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        background-image: url("data:image/svg+xml,%3Csvg width='9' height='9' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 9l6 6 6-6' stroke='%236e6e73' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 8px center;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        width: 110px;
    }

    .status-select:focus {
        outline: none;
        border-color: #1d1d1f;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
    }

    .status-select.activo { background-color: #e8f9ee; border-color: #b8e6c6; color: #1a8a3a; }
    .status-select.inactivo { background-color: #f2f2f4; color: #6e6e73; }

    /* ============================================================
       BOTONES ACCIÓN
       ============================================================ */
    .acciones-tabla {
        display: inline-flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .btn-tabla {
        height: 32px;
        padding: 0 14px;
        background: #ffffff;
        color: #1d1d1f;
        border: 1px solid #e5e5ea;
        border-radius: 8px;
        font-family: inherit;
        font-size: 12.5px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        gap: 5px;
        text-decoration: none;
    }

    .btn-tabla:hover { background: #1d1d1f; color: #ffffff; border-color: #1d1d1f; }

    .btn-tabla.danger { color: #ff3b30; border-color: #ffd0cc; }
    .btn-tabla.danger:hover { background: #ff3b30; color: #ffffff; border-color: #ff3b30; }

    .btn-tabla.key { color: #3a8ab8; border-color: #c5e3f2; }
    .btn-tabla.key:hover { background: #3a8ab8; color: #ffffff; border-color: #3a8ab8; }

    /* ============================================================
       EMPTY STATE
       ============================================================ */
    .empty-row {
        text-align: center;
        padding: 60px 20px;
        color: #6e6e73;
        font-size: 13px;
    }

    /* ============================================================
       TOASTS
       ============================================================ */
    .toast-container {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
        pointer-events: none;
    }

    .toast-custom {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: saturate(180%) blur(24px);
        -webkit-backdrop-filter: saturate(180%) blur(24px);
        border-radius: 14px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12), 0 0 0 0.5px rgba(0, 0, 0, 0.05);
        min-width: 300px;
        max-width: 380px;
        animation: toastIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        pointer-events: auto;
    }

    .toast-custom.success .toast-icon { background: #e8f9ee; color: #34c759; }
    .toast-custom.error .toast-icon { background: #ffebea; color: #ff3b30; }

    .toast-icon {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 16px;
        font-weight: 700;
    }

    .toast-content { flex: 1; }

    .toast-title { font-size: 13.5px; font-weight: 600; color: #1d1d1f; }
    .toast-msg { font-size: 12.5px; color: #6e6e73; margin-top: 1px; }

    .toast-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 2px;
        background: #34c759;
        animation: progress 3s linear forwards;
    }

    .toast-custom.error .toast-progress { background: #ff3b30; }

    @@keyframes toastIn {
        from { opacity: 0; transform: translateX(24px) scale(0.96); }
        to { opacity: 1; transform: translateX(0) scale(1); }
    }

    @@keyframes progress {
        from { width: 100%; }
        to { width: 0%; }
    }

    /* ============================================================
       MODAL CONFIRMACIÓN CUSTOM
       ============================================================ */
    .modal-backdrop-custom {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        animation: fadeInCustom 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .modal-backdrop-custom.show { display: flex; }

    @@keyframes fadeInCustom { from { opacity: 0; } to { opacity: 1; } }

    .modal-custom {
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.18), 0 0 0 0.5px rgba(0, 0, 0, 0.05);
        width: 100%;
        max-width: 400px;
        overflow: hidden;
        animation: modalInCustom 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @@keyframes modalInCustom {
        from { opacity: 0; transform: scale(0.92) translateY(15px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .modal-custom-body { padding: 32px 28px 8px; text-align: center; }

    .modal-custom-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #ffebea;
        color: #ff3b30;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-custom-icon.info { background: #eaf4fb; color: #3a8ab8; }
    .modal-custom-icon.success { background: #e8f9ee; color: #34c759; }

    .modal-custom-title {
        font-family: 'Inter', sans-serif;
        font-size: 18px;
        font-weight: 600;
        color: #1d1d1f;
        letter-spacing: -0.025em;
        margin: 0 0 8px;
    }

    .modal-custom-text { font-size: 13.5px; color: #6e6e73; line-height: 1.5; margin: 0; }
    .modal-custom-text strong { color: #1d1d1f; font-weight: 600; }

    .modal-custom-footer { padding: 24px; display: flex; gap: 10px; }

    .modal-custom-btn {
        flex: 1;
        height: 44px;
        border: none;
        border-radius: 11px;
        font-family: inherit;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .modal-custom-btn.secondary { background: #f2f2f4; color: #1d1d1f; }
    .modal-custom-btn.secondary:hover { background: #e8e8ea; }
    .modal-custom-btn.danger { background: #ff3b30; color: #ffffff; }
    .modal-custom-btn.danger:hover { background: #e02e25; }
    .modal-custom-btn.primary { background: #1d1d1f; color: #ffffff; }
    .modal-custom-btn.primary:hover { background: #000000; }

    /* ============================================================
       MODAL RESTABLECER CONTRASEÑA (custom header)
       ============================================================ */
    #modalRestablecer .modal-content {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.18);
    }

    #modalRestablecer .modal-header {
        border-bottom: 1px solid #e5e5ea;
        padding: 20px 24px;
    }

    #modalRestablecer .modal-title {
        font-family: 'Inter', sans-serif;
        font-size: 16px;
        font-weight: 600;
        color: #1d1d1f;
        letter-spacing: -0.02em;
    }

    #modalRestablecer .modal-body { padding: 24px; }

    #modalRestablecer .form-control {
        border: 1px solid #e5e5ea;
        border-radius: 9px;
        height: 42px;
        font-size: 13.5px;
    }

    #modalRestablecer .form-control:focus {
        border-color: #1d1d1f;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
    }

    #modalRestablecer .modal-footer {
        border-top: 1px solid #e5e5ea;
        padding: 16px 24px;
        gap: 10px;
    }

    #modalRestablecer .btn {
        height: 42px;
        border-radius: 10px;
        font-size: 13.5px;
        font-weight: 500;
        padding: 0 18px;
    }
</style>

<div class="container py-4 usuarios-layout">

    <!-- ==================== HEADER ==================== -->
    <div class="panel-header">
        <div>
            <h1 class="panel-title">Usuarios</h1>
            <p class="panel-subtitle">Administra los usuarios y sus roles de acceso.</p>
        </div>
        @if (puedeCrear)
        {
            <a asp-action="Create" class="btn-apple">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                Crear usuario
            </a>
        }
    </div>

    <!-- ==================== TOOLBAR ==================== -->
    <form asp-action="Index" method="get" class="toolbar-row">
        <div class="search-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.35-4.35"/>
            </svg>
            <input name="search" value="@Model.Search" placeholder="Buscar por usuario o nombre..." />
        </div>

        <select name="idRol" class="select-filter" asp-items="Model.Roles">
            <option value="">Todos los roles</option>
        </select>

        <select name="estado" class="select-filter" asp-items="Model.Estados"></select>

        <button type="submit" class="btn-apple">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.35-4.35"/>
            </svg>
            Filtrar
        </button>

        @if (!string.IsNullOrWhiteSpace(Model.Search) || rolActual.HasValue || estadoActual.HasValue)
        {
            <a asp-action="Index" class="btn-apple secondary">Limpiar</a>
        }
    </form>

    <!-- ==================== TABLA ==================== -->
    <div class="card-tabla">
        <div class="table-responsive">
            <table class="tabla-usuarios">
                <thead>
                    <tr>
                        <th>Nombre completo</th>
                        <th>Usuario</th>
                        <th>Rol</th>
                        <th>Contraseña</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Usuarios.Any())
                {
                    <tr>
                        <td colspan="6" class="empty-row">No se encontraron usuarios.</td>
                    </tr>
                }
                @foreach (var usuario in Model.Usuarios)
                {
                    var esAdmin = usuario.Rol?.Codigo == "ADMIN";
                    var esVendedor = usuario.Rol?.Codigo == "VENDEDORA";
                    var nombreRol = esAdmin ? "Administrador" : esVendedor ? "Vendedor" : usuario.Rol?.Name;

                    <tr>
                        <td>
                            <div class="user-name">@usuario.Nombres @usuario.Apellidos</div>
                        </td>
                        <td>
                            <div class="user-username">@usuario.UserName</div>
                        </td>
                        <td>
                            <span class="badge-rol @(esAdmin ? "admin" : "vendedor")">@nombreRol</span>
                        </td>
                        <td>
                            <button type="button" class="btn-tabla key"
                                    onclick="abrirModalRestablecer(@usuario.Id, '@usuario.UserName')">
                                Restablecer
                            </button>
                        </td>
                        <td>
                            <select class="status-select @(usuario.Estado ? "activo" : "inactivo")"
                                    onchange="cambiarEstado(@usuario.Id, this.value, this)">
                                <option value="true" selected="@usuario.Estado">Activo</option>
                                <option value="false" selected="@(!usuario.Estado)">Inactivo</option>
                            </select>
                        </td>
                        <td>
                            <div class="acciones-tabla">
                                <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn-tabla">
                                    Editar
                                </a>
                                <button type="button" class="btn-tabla danger"
                                        onclick="confirmarEliminar(@usuario.Id, '@usuario.Nombres @usuario.Apellidos')">
                                    Eliminar
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==================== FORMS OCULTOS ==================== -->
<form id="formCambiarEstado" asp-action="CambiarEstado" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="estadoId" />
    <input type="hidden" name="estado" id="estadoValor" />
</form>

<form id="formEliminar" asp-action="Eliminar" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="eliminarId" />
</form>

<!-- ==================== MODAL RESTABLECER CONTRASEÑA ==================== -->
<div class="modal fade" id="modalRestablecer" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="RestablecerPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Restablecer contraseña</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="restablecerId" />
                    <p style="font-size:13.5px; color:#6e6e73; margin-bottom:16px;">
                        Usuario: <strong id="restablecerUsuario" style="color:#1d1d1f;"></strong>
                    </p>
                    <div class="mb-3">
                        <label class="form-label" style="font-size:12px; font-weight:500; color:#6e6e73;">Nueva contraseña</label>
                        <input type="password" name="NuevaPassword" class="form-control" minlength="8" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-size:12px; font-weight:500; color:#6e6e73;">Confirmar contraseña</label>
                        <input type="password" name="ConfirmarPassword" class="form-control" minlength="8" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" style="background:#f2f2f4; color:#1d1d1f; border:none;" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn" style="background:#1d1d1f; color:#ffffff; border:none;">Restablecer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ==================== MODAL CONFIRMACIÓN CUSTOM ==================== -->
<div class="modal-backdrop-custom" id="modalConfirm">
    <div class="modal-custom">
        <div class="modal-custom-body">
            <div class="modal-custom-icon" id="modalConfirmIcon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 8v4M12 16h.01"/>
                </svg>
            </div>
            <h3 class="modal-custom-title" id="modalConfirmTitle">Confirmar acción</h3>
            <p class="modal-custom-text" id="modalConfirmText">¿Estás seguro de continuar?</p>
        </div>
        <div class="modal-custom-footer">
            <button type="button" class="modal-custom-btn secondary" onclick="cerrarModalConfirm()">Cancelar</button>
            <button type="button" class="modal-custom-btn danger" id="modalConfirmBtn">Confirmar</button>
        </div>
    </div>
</div>

<!-- ==================== TOASTS ==================== -->
<div class="toast-container" id="toastContainer"></div>

@section Scripts {
    <script>
        // ==================== MODAL DE CONFIRMACIÓN ====================
        let accionPendiente = null;

        function abrirModalConfirm(titulo, texto, tipo, callback, textoBoton) {
            const modal = document.getElementById('modalConfirm');
            const icon = document.getElementById('modalConfirmIcon');
            const title = document.getElementById('modalConfirmTitle');
            const text = document.getElementById('modalConfirmText');
            const btn = document.getElementById('modalConfirmBtn');

            icon.className = 'modal-custom-icon';
            if (tipo === 'danger') icon.classList.add('danger');
            else if (tipo === 'info') icon.classList.add('info');
            else if (tipo === 'success') icon.classList.add('success');

            title.textContent = titulo;
            text.innerHTML = texto;
            btn.textContent = textoBoton || 'Confirmar';
            btn.className = 'modal-custom-btn ' + (tipo === 'danger' ? 'danger' : 'primary');

            accionPendiente = callback;
            modal.classList.add('show');
        }

        function cerrarModalConfirm() {
            document.getElementById('modalConfirm').classList.remove('show');
            accionPendiente = null;
        }

        document.getElementById('modalConfirmBtn')?.addEventListener('click', function () {
            if (accionPendiente) { accionPendiente(); accionPendiente = null; }
            cerrarModalConfirm();
        });

        document.getElementById('modalConfirm')?.addEventListener('click', function (e) {
            if (e.target === this) cerrarModalConfirm();
        });

        // ==================== CAMBIAR ESTADO ====================
        function cambiarEstado(id, valor, selectElement) {
            const estadoBool = valor === 'true';
            const accion = estadoBool ? 'activar' : 'desactivar';

            abrirModalConfirm(
                (estadoBool ? 'Activar' : 'Desactivar') + ' usuario',
                '¿Estás seguro de ' + accion + ' este usuario?',
                estadoBool ? 'success' : 'danger',
                function () {
                    document.getElementById('estadoId').value = id;
                    document.getElementById('estadoValor').value = valor;
                    document.getElementById('formCambiarEstado').submit();
                },
                estadoBool ? 'Activar' : 'Desactivar'
            );
        }

        // ==================== ELIMINAR ====================
        function confirmarEliminar(id, nombre) {
            abrirModalConfirm(
                'Eliminar usuario',
                '¿Seguro que deseas eliminar al usuario "<strong>' + nombre + '</strong>"? Esta acción no se puede deshacer.',
                'danger',
                function () {
                    document.getElementById('eliminarId').value = id;
                    document.getElementById('formEliminar').submit();
                },
                'Eliminar'
            );
        }

        // ==================== RESTABLECER CONTRASEÑA ====================
        function abrirModalRestablecer(id, userName) {
            document.getElementById('restablecerId').value = id;
            document.getElementById('restablecerUsuario').textContent = userName;
            var modal = new bootstrap.Modal(document.getElementById('modalRestablecer'));
            modal.show();
        }

        // ==================== MOSTRAR TOAST ====================
        function mostrarToast(mensaje, tipo) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'toast-custom ' + (tipo || 'success');

            const icono = tipo === 'error' ? '!' : '✓';
            const titulo = tipo === 'error' ? 'Error' : 'Listo';

            toast.innerHTML = `
                <div class="toast-icon">${icono}</div>
                <div class="toast-content">
                    <div class="toast-title">${titulo}</div>
                    <div class="toast-msg">${mensaje}</div>
                </div>
                <div class="toast-progress"></div>
            `;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(24px) scale(0.96)';
                toast.style.transition = 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // ==================== TOAST AL CARGAR ====================
        @if (TempData["SuccessMessage"] is string ok)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function () {
                mostrarToast('@ok', 'success');
            });
            </text>
        }
        @if (TempData["ErrorMessage"] is string err)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function () {
                mostrarToast('@err', 'error');
            });
            </text>
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
}