@{
    ViewData["Title"] = "Usuarios";
}

@model IEnumerable<AguaSantaClara.Web.Models.Entities.Usuario>

<h1>Usuarios</h1>
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Administra los usuarios y sus roles de acceso.</p>
    @if (User.IsInRole("Gerente"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Crear usuario
        </a>
    }
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre completo</th>
                <th>Usuario</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.Nombres @usuario.Apellidos</td>
                <td>@usuario.UserName</td>
                <td>@usuario.Email</td>
                <td>@(usuario.Rol?.Codigo == "ADMIN" ? "Administrador" : usuario.Rol?.Codigo == "VENDEDORA" ? "Vendedor" : usuario.Rol?.Name)</td>
                <td>
                    <span class="badge @(usuario.Estado ? "text-bg-success" : "text-bg-secondary")">
                        @(usuario.Estado ? "Activo" : "Inactivo")
                    </span>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>