@model AguaSantaClara.Web.Models.PedidosIndexViewModel

@{
    ViewData["Title"] = "Pedidos";
    var esVendedora = User.IsInRole("Vendedora");
    var estadoActual = Model.EstadoFiltro;
}

<style>
    body.app-body {
        background: linear-gradient(180deg, #eaf4fb 0%, #f0f7fc 40%, #fbfcfd 100%) !important;
        background-attachment: fixed !important;
    }

    .pedidos-layout {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .panel-title {
        font-size: 20px;
        font-weight: 700;
        color: #1d1d1f;
        letter-spacing: -0.03em;
        margin: 0;
    }

    .panel-subtitle {
        font-size: 12.5px;
        color: #6e6e73;
        margin: 4px 0 0;
    }

    .btn-apple {
        height: 36px;
        padding: 0 16px;
        background: #1d1d1f;
        color: #ffffff;
        border: none;
        border-radius: 9px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        text-decoration: none;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
    }

    .btn-apple:hover {
        background: #000000;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
    }

    .btn-apple:active { transform: translateY(0); }

    .btn-apple:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
    }

    .btn-apple.success { background: #34c759; }
    .btn-apple.success:hover { background: #2aa84a; }

    .toolbar-row {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
        padding: 16px 20px;
        background: #ffffff;
        border: 1px solid #e5e5ea;
        border-radius: 14px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .select-filter {
        height: 36px;
        padding: 0 32px 0 12px;
        border: 1px solid #e5e5ea;
        border-radius: 9px;
        background: #fbfcfd;
        font-family: inherit;
        font-size: 12.5px;
        color: #1d1d1f;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        background-image: url("data:image/svg+xml,%3Csvg width='10' height='10' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 9l6 6 6-6' stroke='%236e6e73' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 10px center;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        min-width: 160px;
    }

    .select-filter:focus {
        outline: none;
        background-color: #ffffff;
        border-color: #1d1d1f;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
    }

    .card-tabla {
        background: #ffffff;
        border: 1px solid #e5e5ea;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .tabla-pedidos {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

    .tabla-pedidos thead th {
        text-align: left;
        padding: 14px 16px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 600;
        color: #6e6e73;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        background: #fbfcfd;
        border-bottom: 1px solid #e5e5ea;
        white-space: nowrap;
    }

    .tabla-pedidos tbody td {
        padding: 14px 16px;
        font-size: 13px;
        color: #1d1d1f;
        border-bottom: 1px solid #f0f0f2;
        vertical-align: middle;
    }

    .tabla-pedidos tbody tr:last-child td { border-bottom: none; }
    .tabla-pedidos tbody tr:hover { background: #fbfcfd; }

    .status-select {
        height: 30px;
        padding: 0 26px 0 10px;
        border-radius: 7px;
        border: 1px solid #e5e5ea;
        background-color: #ffffff;
        font-family: inherit;
        font-size: 11.5px;
        font-weight: 500;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        background-image: url("data:image/svg+xml,%3Csvg width='9' height='9' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 9l6 6 6-6' stroke='%236e6e73' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 8px center;
        width: 130px;
    }

    .status-select:focus {
        outline: none;
        border-color: #1d1d1f;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
    }

    .status-select.pendiente { background-color: #fff7e6; border-color: #ffe0a3; color: #b8860b; }
    .status-select.enviado { background-color: #eaf4fb; border-color: #b8d9ef; color: #3a8ab8; }
    .status-select.entregado { background-color: #e8f9ee; border-color: #b8e6c6; color: #1a8a3a; }

    .status-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 11.5px;
        font-weight: 600;
    }

    .status-badge.pendiente { background: #fff7e6; color: #b8860b; }
    .status-badge.enviado { background: #eaf4fb; color: #3a8ab8; }
    .status-badge.entregado { background: #e8f9ee; color: #1a8a3a; }

    .acciones-tabla {
        display: inline-flex;
        gap: 6px;
    }

    .btn-tabla {
        height: 30px;
        padding: 0 12px;
        background: #ffffff;
        color: #1d1d1f;
        border: 1px solid #e5e5ea;
        border-radius: 7px;
        font-family: inherit;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        gap: 5px;
        text-decoration: none;
    }

    .btn-tabla:hover {
        background: #1d1d1f;
        color: #ffffff;
        border-color: #1d1d1f;
    }

    .btn-tabla.danger {
        color: #ff3b30;
        border-color: #ffd0cc;
    }

    .btn-tabla.danger:hover {
        background: #ff3b30;
        color: #ffffff;
        border-color: #ff3b30;
    }

    .split-btn {
        display: inline-flex;
        height: 36px;
        border-radius: 9px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
    }

    .split-btn-main {
        height: 36px;
        padding: 0 14px;
        background: #34c759;
        color: #ffffff;
        border: none;
        font-family: inherit;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .split-btn-main:hover { background: #2aa84a; }
    .split-btn-main:disabled { opacity: 0.5; cursor: not-allowed; }

    .split-btn-toggle {
        height: 36px;
        width: 32px;
        background: #34c759;
        color: #ffffff;
        border: none;
        border-left: 1px solid rgba(255, 255, 255, 0.3);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .split-btn-toggle:hover { background: #2aa84a; }
    .split-btn-toggle:disabled { opacity: 0.5; cursor: not-allowed; }

    .split-btn-menu {
        position: absolute;
        z-index: 1000;
        min-width: 220px;
        max-height: 300px;
        overflow-y: auto;
        background: #ffffff;
        border: 1px solid #e5e5ea;
        border-radius: 12px;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
        padding: 6px;
        margin-top: 4px;
        display: none;
        top: 100%;
        right: 0;
    }

    .split-btn-menu.show { display: block; }

    .split-btn-item {
        display: block;
        width: 100%;
        padding: 8px 12px;
        background: transparent;
        border: none;
        border-radius: 8px;
        font-family: inherit;
        font-size: 13px;
        color: #1d1d1f;
        text-align: left;
        cursor: pointer;
        transition: background 0.15s;
    }

    .split-btn-item:hover { background: #f2f2f4; }

    .empty-row {
        text-align: center;
        padding: 60px 20px;
        color: #6e6e73;
        font-size: 13px;
    }

    .toast-container {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
        pointer-events: none;
    }

    .toast-custom {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: saturate(180%) blur(24px);
        -webkit-backdrop-filter: saturate(180%) blur(24px);
        border-radius: 14px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12), 0 0 0 0.5px rgba(0, 0, 0, 0.05);
        min-width: 300px;
        max-width: 380px;
        animation: toastIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        pointer-events: auto;
    }

    .toast-custom.success .toast-icon { background: #e8f9ee; color: #34c759; }
    .toast-custom.error .toast-icon { background: #ffebea; color: #ff3b30; }

    .toast-icon {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 16px;
        font-weight: 700;
    }

    .toast-content { flex: 1; }
    .toast-title { font-size: 13.5px; font-weight: 600; color: #1d1d1f; }
    .toast-msg { font-size: 12.5px; color: #6e6e73; margin-top: 1px; }

    .toast-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 2px;
        background: #34c759;
        animation: progress 3s linear forwards;
    }

    .toast-custom.error .toast-progress { background: #ff3b30; }

    @@keyframes toastIn {
        from { opacity: 0; transform: translateX(24px) scale(0.96); }
        to { opacity: 1; transform: translateX(0) scale(1); }
    }

    @@keyframes progress {
        from { width: 100%; }
        to { width: 0%; }
    }

    .modal-backdrop-custom {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        animation: fadeInCustom 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .modal-backdrop-custom.show { display: flex; }

    @@keyframes fadeInCustom { from { opacity: 0; } to { opacity: 1; } }

    .modal-custom {
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.18), 0 0 0 0.5px rgba(0, 0, 0, 0.05);
        width: 100%;
        max-width: 400px;
        overflow: hidden;
        animation: modalInCustom 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @@keyframes modalInCustom {
        from { opacity: 0; transform: scale(0.92) translateY(15px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .modal-custom-body { padding: 32px 28px 8px; text-align: center; }

    .modal-custom-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #ffebea;
        color: #ff3b30;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-custom-icon.info { background: #eaf4fb; color: #3a8ab8; }
    .modal-custom-icon.success { background: #e8f9ee; color: #34c759; }

    .modal-custom-title {
        font-family: 'Inter', sans-serif;
        font-size: 18px;
        font-weight: 600;
        color: #1d1d1f;
        letter-spacing: -0.025em;
        margin: 0 0 8px;
    }

    .modal-custom-text { font-size: 13.5px; color: #6e6e73; line-height: 1.5; margin: 0; }
    .modal-custom-text strong { color: #1d1d1f; font-weight: 600; }

    .modal-custom-footer { padding: 24px; display: flex; gap: 10px; }

    .modal-custom-btn {
        flex: 1;
        height: 44px;
        border: none;
        border-radius: 11px;
        font-family: inherit;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .modal-custom-btn.secondary { background: #f2f2f4; color: #1d1d1f; }
    .modal-custom-btn.secondary:hover { background: #e8e8ea; }
    .modal-custom-btn.danger { background: #ff3b30; color: #ffffff; }
    .modal-custom-btn.danger:hover { background: #e02e25; }
    .modal-custom-btn.primary { background: #1d1d1f; color: #ffffff; }
    .modal-custom-btn.primary:hover { background: #000000; }
</style>

<div class="container py-4 pedidos-layout">

    <!-- HEADER -->
    <div class="panel-header">
        <div>
            <h1 class="panel-title">Pedidos</h1>
            <p class="panel-subtitle">Registro, envío y seguimiento de pedidos.</p>
        </div>
        @if (esVendedora)
        {
            <button type="button" class="btn-apple" id="btnNuevoPedido">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                Crear pedido
            </button>
        }
    </div>

    <!-- FILTROS -->
    <form asp-action="Index" method="get" class="toolbar-row">
        @if (!string.IsNullOrEmpty(Model.ErrorFiltros))
        {
            <div style="flex: 1 0 100%; background:#ffebea; border:1px solid #ffd0cc; color:#ff3b30; padding:10px 14px; border-radius:9px; font-size:12.5px;">
                @Model.ErrorFiltros
            </div>
        }

        <select name="estado" class="select-filter">
            <option value="">Todos los estados</option>
            @foreach (var estado in AguaSantaClara.Web.Models.Entities.EstadosPedido.Todos)
            {
                <option value="@estado" selected="@(estadoActual == estado ? "selected" : null)">@estado</option>
            }
        </select>

        <select name="idCliente" class="select-filter">
            <option value="">Todos los clientes</option>
            @foreach (var cliente in Model.ClientesFiltro)
            {
                <option value="@cliente.Id" selected="@(Model.IdClienteFiltro == cliente.Id ? "selected" : null)">@cliente.Nombre</option>
            }
        </select>

        <select name="idRepartidor" class="select-filter">
            <option value="">Todos los repartidores</option>
            @foreach (var repartidor in Model.RepartidoresFiltro)
            {
                <option value="@repartidor.Id" selected="@(Model.IdRepartidorFiltro == repartidor.Id ? "selected" : null)">@repartidor.Nombre</option>
            }
        </select>

        <button type="submit" class="btn-apple">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.35-4.35"/>
            </svg>
            Filtrar
        </button>

        @if (!string.IsNullOrWhiteSpace(estadoActual) || Model.IdClienteFiltro.HasValue || Model.IdRepartidorFiltro.HasValue)
        {
            <a asp-action="Index" class="btn-apple" style="background:#f2f2f4;color:#1d1d1f;">Limpiar</a>
        }
    </form>

    <!-- BARRA DE ACCIONES -->
    @if (esVendedora)
    {
        <div id="pedidosAcciones" class="toolbar-row" style="justify-content:space-between;">
            @Html.AntiForgeryToken()
            <span style="font-size:13px;color:#6e6e73;"><strong id="pedidosSeleccionados" style="color:#1d1d1f;">0</strong> seleccionado(s)</span>

            <div style="position:relative; display:inline-flex;" id="splitBtnWrapper">
                <div class="split-btn">
                    <button type="button" id="pedidosEnviarBtn" class="split-btn-main" disabled>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                        </svg>
                        Enviar a
                    </button>
                    <button type="button" id="pedidosEnviarToggle" class="split-btn-toggle" disabled aria-label="Seleccionar repartidor">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 9l6 6 6-6"/>
                        </svg>
                    </button>
                </div>
                <div class="split-btn-menu" id="repartidoresMenu">
                    @if (!Model.Repartidores.Any())
                    {
                        <div style="padding:12px; font-size:12.5px; color:#6e6e73; text-align:center;">
                            No hay repartidores activos.
                        </div>
                    }
                    else
                    {
                        foreach (var repartidor in Model.Repartidores)
                        {
                            <button type="button" class="split-btn-item" data-repartidor-id="@repartidor.Id" data-repartidor-nombre="@repartidor.Nombre">
                                @repartidor.Nombre
                            </button>
                        }
                    }
                </div>
            </div>
        </div>
    }

    <!-- TABLA -->
    <div class="card-tabla">
        <div style="overflow-x:auto;">
            <table class="tabla-pedidos">
                <thead>
                    <tr>
                        @if (esVendedora)
                        {
                            <th style="width:40px;">
                                <input type="checkbox" id="pedidosSeleccionarTodos" class="form-check-input" aria-label="Seleccionar todos" />
                            </th>
                        }
                        <th>Fecha</th>
                        <th>Locales</th>
                        <th>Cliente</th>
                        <th>Repartidor</th>
                        <th style="text-align:right;">Total</th>
                        <th>Estado</th>
                        @if (esVendedora)
                        {
                            <th>Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Pedidos.Any())
                    {
                        <tr>
                            <td colspan="@(esVendedora ? 8 : 6)" class="empty-row">
                                @(Model.TieneFiltrosAplicados ? "No se encontraron pedidos con esos filtros." : "No hay pedidos registrados.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var pedido in Model.Pedidos)
                        {
                            var localesPedido = pedido.Clientes
                                .SelectMany(c => c.Detalles)
                                .Select(d => d.Local?.Nombre)
                                .Where(n => !string.IsNullOrWhiteSpace(n))
                                .Distinct()
                                .ToList();

                            var nombreCliente = pedido.Clientes
                                .Select(c => c.Cliente.Nombre)
                                .FirstOrDefault() ?? "—";

                            var claseEstado = pedido.Estado switch
                            {
                                "Pendiente" => "pendiente",
                                "Enviado" => "enviado",
                                "Entregado" => "entregado",
                                _ => ""
                            };

                            <tr>
                                @if (esVendedora)
                                {
                                    <td>
                                        <input type="checkbox" class="form-check-input pedido-check" value="@pedido.Id"
                                               aria-label="Seleccionar pedido" />
                                    </td>
                                }
                                <td>@DateTime.SpecifyKind(pedido.FechaCreacion, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(localesPedido.Any() ? string.Join(", ", localesPedido) : "—")</td>
                                <td>@nombreCliente</td>
                                <td>@(pedido.Repartidor?.Nombre ?? "—")</td>
                                <td style="text-align:right;">S/ @pedido.Total.ToString("0.00")</td>
                                <td>
                                    @if (esVendedora && pedido.Estado == "Enviado")
                                    {
                                        // Solo dropdown cuando está Enviado → puede pasar a Entregado
                                        <select class="status-select enviado pedido-estado" data-pedido-id="@pedido.Id"
                                                data-estado-original="@pedido.Estado"
                                                aria-label="Estado del pedido">
                                            <option value="Enviado" selected>Enviado</option>
                                            <option value="Entregado">Entregado</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="status-badge @claseEstado">@pedido.Estado</span>
                                    }
                                </td>
                                @if (esVendedora)
                                {
                                    <td>
                                        <div class="acciones-tabla">
                                            @if (pedido.Estado == "Pendiente")
                                            {
                                                <button type="button" class="btn-tabla pedido-editar"
                                                        data-pedido-id="@pedido.Id"
                                                        data-bs-toggle="modal" data-bs-target="#pedidoModal">
                                                    Editar
                                                </button>

                                                <button type="button" class="btn-tabla danger pedido-eliminar"
                                                        data-pedido-id="@pedido.Id">
                                                    Eliminar
                                                </button>
                                            }
                                            else if (pedido.Estado == "Enviado")
                                            {
                                                <button type="button"
                                                        class="btn-tabla pedido-incidencia"
                                                        data-pedido-id="@pedido.Id">
                                                    Registrar Incidencia
                                                </button>
                                            }
                                            else
                                            {
                                                <span style="font-size:11.5px;color:#a1a1a6;font-style:italic;">—</span>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (esVendedora)
{
    <partial name="_CrearPedido" model="Model" />
}

<!-- MODAL REGISTRAR INCIDENCIA -->
<div class="modal fade" id="incidenciaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px; border:none;">
            <div class="modal-header">
                <h5 class="modal-title">Registrar incidencia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="incidenciaPedidoId" />

                <label for="incidenciaMotivo" class="form-label">
                    Motivo de la incidencia
                </label>

                <select id="incidenciaMotivo" class="form-select">
                    <option value="">Seleccione un motivo</option>
                    <option value="Cliente ausente">Cliente ausente</option>
                    <option value="Dirección incorrecta">Dirección incorrecta</option>
                    <option value="Producto dañado">Producto dañado</option>
                    <option value="Vehículo descompuesto">Vehículo descompuesto</option>
                    <option value="Otros">Otros</option>
                </select>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PREVIEW MENSAJE -->
<div class="modal fade" id="previewEnvioModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content" style="border-radius:14px; border:none;">
            <div class="modal-header" style="border-bottom:1px solid #e5e5ea;">
                <h5 class="modal-title" style="font-size:15px;font-weight:600;">Vista previa del mensaje</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p style="font-size:12.5px;color:#6e6e73;margin-bottom:10px;">
                    Destinatario: <strong id="previewEnvioDestinatario" style="color:#1d1d1f;"></strong>
                </p>
                <pre id="previewEnvioMensaje" style="background:#fbfcfd; border:1px solid #e5e5ea; padding:14px; border-radius:10px; white-space:pre-wrap; font-family:'JetBrains Mono', monospace; font-size:12px; max-height:400px; overflow-y:auto; margin:0;"></pre>
            </div>
            <div class="modal-footer" style="border-top:1px solid #e5e5ea;">
                <button type="button" class="btn-apple" style="background:#f2f2f4;color:#1d1d1f;" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="previewEnvioConfirmar" class="btn-apple success">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                    </svg>
                    Confirmar y abrir WhatsApp
                </button>
            </div>
        </div>
    </div>
</div>

<!-- TOASTS -->
<div class="toast-container" id="toastContainer"></div>

<!-- MODAL CONFIRMACIÓN CUSTOM -->
<div class="modal-backdrop-custom" id="modalConfirm">
    <div class="modal-custom">
        <div class="modal-custom-body">
            <div class="modal-custom-icon" id="modalConfirmIcon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 8v4M12 16h.01"/>
                </svg>
            </div>
            <h3 class="modal-custom-title" id="modalConfirmTitle">Confirmar acción</h3>
            <p class="modal-custom-text" id="modalConfirmText">¿Estás seguro de continuar?</p>
        </div>
        <div class="modal-custom-footer">
            <button type="button" class="modal-custom-btn secondary" onclick="cerrarModalConfirm()">Cancelar</button>
            <button type="button" class="modal-custom-btn danger" id="modalConfirmBtn">Confirmar</button>
        </div>
    </div>
</div>

@section Scripts {
    @if (esVendedora)
    {
        <script>
            window.__pedidosData = {
                locales: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    Model.Locales.Select(l => new { id = l.Id, nombre = l.Nombre })
                )),
                repartidores: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    Model.Repartidores.Select(r => new { id = r.Id, nombre = r.Nombre })
                ))
            };
        </script>
        <script src="~/js/pedidos.js" asp-append-version="true"></script>
        <script src="~/js/pedidos-lista.js" asp-append-version="true"></script>
    }
    <partial name="_ValidationScriptsPartial" />
}