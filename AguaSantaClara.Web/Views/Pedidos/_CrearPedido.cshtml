@model AguaSantaClara.Web.Models.PedidosIndexViewModel

<div class="modal fade" id="pedidoModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px; border:none;">

            <div class="modal-header" style="border-bottom:1px solid #e5e5ea;">
                <div>
                    <h5 class="modal-title" id="pedidoModalLabel" style="font-size:16px;font-weight:600;">Crear pedido</h5>
                    <p style="font-size:12.5px;color:#6e6e73;margin:2px 0 0;">Selecciona un cliente, sus direcciones y productos.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                @Html.AntiForgeryToken()
                <div id="pedidoErrores" class="alert alert-danger d-none" role="alert" style="border-radius:10px;"></div>

                <div id="pedidoFormulario">

                    <!-- BUSCADOR DE CLIENTE -->
                    <div id="buscadorCliente" style="position:relative; margin-bottom:20px;">
                        <label class="form-label" style="font-size:12.5px;font-weight:600;color:#1d1d1f;">Buscar cliente</label>
                        <div style="position:relative;">
                            <input id="pedidoBuscar" type="text" class="form-control"
                                   autocomplete="off" placeholder="Nombre, teléfono o DNI..."
                                   style="height:42px;padding-left:38px;" />
                            <svg style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#a1a1a6;pointer-events:none;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="m21 21-4.35-4.35"/>
                            </svg>
                            <div id="autocompleteDropdown" style="position:absolute;top:100%;left:0;right:0;background:#ffffff;border:1px solid #e5e5ea;border-radius:10px;box-shadow:0 12px 32px rgba(0,0,0,0.10);margin-top:4px;max-height:280px;overflow-y:auto;display:none;z-index:1050;"></div>
                        </div>
                        <div id="pedidoBuscarMensaje" style="font-size:12px;color:#ff3b30;margin-top:4px;"></div>
                    </div>

                    <!-- CABECERA DEL CLIENTE SELECCIONADO -->
                    <div id="clienteSeleccionado" style="display:none; margin-bottom:16px; padding:14px 16px; background:#fbfcfd; border:1px solid #e5e5ea; border-radius:12px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
                            <div>
                                <strong id="clienteNombre" style="font-size:14px;color:#1d1d1f;"></strong>
                                <div id="clienteMeta" style="font-size:12px;color:#6e6e73;margin-top:2px;"></div>
                            </div>
                            <button type="button" id="btnCambiarCliente" class="btn-apple" style="background:#f2f2f4;color:#1d1d1f;height:30px;font-size:12px;padding:0 12px;">
                                Cambiar cliente
                            </button>
                        </div>
                    </div>

                    <!-- BLOQUES DE DIRECCIONES -->
                    <div id="pedidoDirecciones" style="display:grid;gap:14px;"></div>

                    <!-- BOTÓN AGREGAR DIRECCIÓN -->
                    <div id="wrapperAgregarDireccion" style="display:none; margin-top:12px;">
                        <button type="button" id="btnAgregarDireccion" class="btn-apple" style="background:#f2f2f4;color:#1d1d1f;">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 5v14M5 12h14"/>
                            </svg>
                            Agregar otra dirección
                        </button>
                    </div>

                    <!-- ESTADO VACÍO -->
                    <div id="pedidoVacio" style="text-align:center;padding:40px 20px;color:#a1a1a6;font-size:13px;">
                        Busca y selecciona un cliente para comenzar.
                    </div>
                </div>

                <div id="pedidoEnviado" class="alert alert-success d-none" role="status" style="border-radius:10px;">
                    <p class="mb-2">Pedido <strong id="pedidoEnviadoNumero"></strong> enviado correctamente.</p>
                    <a id="pedidoWhatsapp" href="#" target="_blank" rel="noopener noreferrer" class="btn-apple success">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                        Abrir WhatsApp
                    </a>
                </div>
            </div>

            <div class="modal-footer" style="border-top:1px solid #e5e5ea;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                <div style="font-size:15px;color:#1d1d1f;">
                    Total: <strong id="pedidoTotal" style="font-weight:700;">S/ 0.00</strong>
                </div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <button type="button" id="pedidoCancelarBtn" class="btn-apple" style="background:#f2f2f4;color:#1d1d1f;" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" id="pedidoGuardarBtn" class="btn-apple">Guardar pedido</button>
                    <button type="button" id="pedidoEnviarBtn" class="btn-apple success">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                        </svg>
                        Guardar y enviar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>