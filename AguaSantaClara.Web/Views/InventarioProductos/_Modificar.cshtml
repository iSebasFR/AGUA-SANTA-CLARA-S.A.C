@using AguaSantaClara.Web.Models
@model AguaSantaClara.Web.Models.ModificarStockProductoViewModel

<div class="modal-header border-0 pb-1">
    <div>
        <h5 class="modal-title fw-semibold mb-1">
            Modificar cantidad
        </h5>

        <div class="small text-muted">
            <strong class="text-dark">@Model.NombreProducto</strong>
            · Stock actual: @Model.StockActual
        </div>
    </div>

    <button type="button"
            class="btn-close"
            data-bs-dismiss="modal">
    </button>
</div>

<form id="formModificarStock">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="IdProducto"
           value="@Model.IdProducto" />

    <input type="hidden"
           name="IdLocal"
           value="@Model.IdLocal" />

    <input type="hidden"
           name="NombreProducto"
           value="@Model.NombreProducto" />

    <input type="hidden"
           name="StockActual"
           value="@Model.StockActual" />

    <div class="modal-body pt-2">

        <div asp-validation-summary="ModelOnly"
             class="text-danger small mb-3">
        </div>

        <div class="mb-3">
            <label class="form-label small fw-semibold text-uppercase">
                Acción
            </label>

                <div class="stock-action-group">
                    <input type="radio"
                        class="btn-check"
                        name="Accion"
                        id="accionAumentar"
                        value="Aumentar"
                        @(Model.Accion == "Aumentar" ? "checked" : "")>

                    <label class="stock-action increase" for="accionAumentar">
                        <span class="stock-action-icon">↑</span>
                        Aumentar
                    </label>

                    <input type="radio"
                        class="btn-check"
                        name="Accion"
                        id="accionDescontar"
                        value="Descontar"
                        @(Model.Accion == "Descontar" ? "checked" : "")>

                    <label class="stock-action decrease" for="accionDescontar">
                        <span class="stock-action-icon">↓</span>
                        Descontar
                    </label>
                </div>

            <span asp-validation-for="Accion"
                  class="text-danger small">
            </span>
        </div>

        <div class="mb-3">
            <label for="cantidad"
                   class="form-label small fw-semibold text-uppercase">
                Cantidad
            </label>

            <input type="number"
                   id="cantidad"
                   name="Cantidad"
                   class="form-control stock-input"
                   min="1"
                   step="1"
                   value="@Model.Cantidad"
                   placeholder="Ingrese la cantidad">

            <span asp-validation-for="Cantidad"
                  class="text-danger small">
            </span>
        </div>

        <div class="mb-2">
            <label for="motivo"
                   class="form-label small fw-semibold text-uppercase">
                Motivo
            </label>

            <select id="motivo"
                    name="Motivo"
                    class="form-select stock-input">

                @foreach (var motivo in StockProductoHelper.PorAccion[Model.Accion])
                {
                    <option value="@motivo"
                            selected="@(Model.Motivo == motivo)">
                        @motivo
                    </option>
                }

            </select>

            <span asp-validation-for="Motivo"
                  class="text-danger small">
            </span>
        </div>

    </div>

    <div class="modal-footer border-0 pt-0">

        <button type="button"
                class="btn btn-light stock-btn-cancel"
                data-bs-dismiss="modal">
            Cancelar
        </button>

        <button type="submit"
                class="btn stock-btn-save"
                id="btnGuardarStock">
            Guardar
        </button>

    </div>

</form>