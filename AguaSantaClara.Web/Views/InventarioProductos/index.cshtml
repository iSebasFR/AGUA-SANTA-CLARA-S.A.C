@model IEnumerable<AguaSantaClara.Web.Models.Entities.Local>

@{
    ViewData["Title"] = "Inventario de productos";
}

<link rel="stylesheet"
      href="~/css/inventario-productos.css"
      asp-append-version="true" />

<style>
    body.app-body {
        background: linear-gradient(180deg, #eaf4fb 0%, #f0f7fc 40%, #fbfcfd 100%) !important;
        background-attachment: fixed !important;
    }

    .panel-title {
        font-size: 20px;
        font-weight: 700;
        color: #1d1d1f;
        letter-spacing: -0.03em;
        margin: 0;
    }

    .panel-subtitle {
        font-size: 12.5px;
        color: #6e6e73;
        margin: 4px 0 0;
    }

    .inventario-local-card {
        background: #ffffff;
        border: 1px solid #e5e5ea;
        border-radius: 14px;
        padding: 16px 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .inventario-local-card label {
        font-size: 12.5px;
        font-weight: 600;
        color: #1d1d1f;
        margin: 0;
        white-space: nowrap;
    }

    .select-filter {
        height: 36px;
        padding: 0 32px 0 12px;
        border: 1px solid #e5e5ea;
        border-radius: 9px;
        background: #fbfcfd;
        font-family: inherit;
        font-size: 12.5px;
        color: #1d1d1f;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        background-image: url("data:image/svg+xml,%3Csvg width='10' height='10' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 9l6 6 6-6' stroke='%236e6e73' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 10px center;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        min-width: 220px;
    }

    .select-filter:focus {
        outline: none;
        background-color: #ffffff;
        border-color: #1d1d1f;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
    }

    .card-tabla {
        background: #ffffff;
        border: 1px solid #e5e5ea;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .tabla-inventario {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

    .tabla-inventario thead th {
        text-align: left;
        padding: 14px 16px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 600;
        color: #6e6e73;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        background: #fbfcfd;
        border-bottom: 1px solid #e5e5ea;
        white-space: nowrap;
    }

    .tabla-inventario tbody td {
        padding: 14px 16px;
        font-size: 13px;
        color: #1d1d1f;
        border-bottom: 1px solid #f0f0f2;
        vertical-align: middle;
    }

    .tabla-inventario tbody tr:last-child td { border-bottom: none; }
    .tabla-inventario tbody tr:hover { background: #fbfcfd; }

    .prod-name {
        font-weight: 600;
        color: #1d1d1f;
    }

    .badge-categoria {
        display: inline-block;
        padding: 3px 10px;
        background: #eaf4fb;
        color: #3a8ab8;
        border-radius: 6px;
        font-size: 11.5px;
        font-weight: 600;
    }

    .stock-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        font-family: 'JetBrains Mono', monospace;
        background: #e8f9ee;
        color: #1a8a3a;
    }

    .btn-tabla {
        height: 30px;
        padding: 0 12px;
        background: #ffffff;
        color: #1d1d1f;
        border: 1px solid #e5e5ea;
        border-radius: 7px;
        font-family: inherit;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .btn-tabla:hover {
        background: #1d1d1f;
        color: #ffffff;
        border-color: #1d1d1f;
    }

    .empty-row {
        text-align: center;
        padding: 60px 20px;
        color: #6e6e73;
        font-size: 13px;
    }
</style>

<div class="container py-4">

    <!-- HEADER -->
    <div style="margin-bottom:20px;">
        <h1 class="panel-title">Inventario de productos</h1>
        <p class="panel-subtitle">Consulta y actualiza el stock por sucursal.</p>
    </div>

    <!-- SELECTOR DE LOCAL -->
    <div class="inventario-local-card">
        <label for="local">Local:</label>
        <select id="local" class="select-filter">
            <option value="">Selecciona un local</option>
            @foreach (var local in Model)
            {
                <option value="@local.Id">@local.Nombre</option>
            }
        </select>
    </div>

    <!-- TABLA -->
    <div class="card-tabla">
        <div style="overflow-x:auto;">
            <table class="tabla-inventario">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Stock actual</th>
                        <th style="text-align:right;">Acciones</th>
                    </tr>
                </thead>
                <tbody id="productosInventario">
                    <tr>
                        <td colspan="4" class="empty-row">
                            Selecciona un local para ver sus productos.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Modal -->
<div class="modal fade"
     id="modalModificarStock"
     tabindex="-1"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="contenidoModalStock"></div>
    </div>
</div>

<!-- Toasts -->
<div class="toast-container" id="toastContainer"></div>

@section Scripts {
    <script>
        function escapeHtml(value) {
            return String(value ?? "").replace(/[&<>"']/g, character => ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;"
            }[character]));
        }

        // ============ TOAST APPLE ============
        function mostrarToast(mensaje, tipo) {
            const container = document.getElementById("toastContainer");
            if (!container) return;

            const toast = document.createElement("div");
            toast.className = "toast-custom " + (tipo || "success");
            const icono = tipo === "error" ? "!" : "✓";
            const titulo = tipo === "error" ? "Error" : "Listo";

            toast.innerHTML = `
                <div class="toast-icon">${icono}</div>
                <div class="toast-content">
                    <div class="toast-title">${titulo}</div>
                    <div class="toast-msg">${escapeHtml(mensaje)}</div>
                </div>
                <div class="toast-progress"></div>
            `;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = "0";
                toast.style.transform = "translateX(24px) scale(0.96)";
                toast.style.transition = "all 0.3s cubic-bezier(0.4, 0, 0.2, 1)";
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // ============ HELPER: SALDO FORMATEADO ============
        function formatearSaldo(saldo) {
            if (saldo > 0) {
                return { texto: `Pendiente de devolver: ${saldo}`, color: "#b8860b" };
            } else if (saldo < 0) {
                return { texto: `Bidones a favor: ${Math.abs(saldo)}`, color: "#1a8a3a" };
            } else {
                return { texto: "Sin bidones pendientes", color: "#6e6e73" };
            }
        }

        // ============ CARGAR PRODUCTOS POR LOCAL ============
        document.getElementById("local").addEventListener("change", async function () {
            const idLocal = this.value;
            const tbody = document.getElementById("productosInventario");

            if (!idLocal) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="4" class="empty-row">
                            Selecciona un local para ver sus productos.
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = `
                <tr>
                    <td colspan="4" class="empty-row">Cargando productos...</td>
                </tr>
            `;

            try {
                const response = await fetch(
                    `/Inventario/Productos/ProductosPorLocal?idLocal=${idLocal}`
                );

                if (!response.ok) throw new Error("No se pudieron cargar los productos.");

                const productos = await response.json();

                if (productos.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="4" class="empty-row">
                                No hay productos disponibles para este local.
                            </td>
                        </tr>
                    `;
                    return;
                }

                tbody.innerHTML = productos.map(producto => {
                    const esBidon = (producto.categoria || "").toLowerCase() === "bidón"
                                || (producto.categoria || "").toLowerCase() === "bidon";

                    const boton = esBidon
                        ? `<button type="button"
                                    class="btn-tabla btn-balancear-bidones"
                                    data-id-local="${idLocal}"
                                    data-id-producto="${producto.id}">
                                <i class="bi bi-arrow-left-right"></i> Balancear bidones
                        </button>`
                        : `<button type="button"
                                    class="btn-tabla btn-modificar-stock"
                                    data-id-local="${idLocal}"
                                    data-id-producto="${producto.id}">
                                <i class="bi bi-pencil-square"></i> Modificar cantidad
                        </button>`;

                    return `
                        <tr>
                            <td><span class="prod-name">${escapeHtml(producto.nombre)}</span></td>
                            <td><span class="badge-categoria">${escapeHtml(producto.categoria || "-")}</span></td>
                            <td><span class="stock-pill">${producto.stock} unid.</span></td>
                            <td style="text-align:right;">${boton}</td>
                        </tr>
                    `;
                }).join("");

            } catch (error) {
                console.error("Error al cargar productos:", error);
                tbody.innerHTML = `
                    <tr>
                        <td colspan="4" class="empty-row" style="color:#ff3b30;">
                            Ocurrió un error al cargar los productos.
                        </td>
                    </tr>
                `;
            }
        });

        // ============ ABRIR MODAL MODIFICAR ============
        document.addEventListener("click", async function (event) {
            const boton = event.target.closest(".btn-modificar-stock");
            if (!boton) return;

            const idLocal = boton.dataset.idLocal;
            const idProducto = boton.dataset.idProducto;

            try {
                const response = await fetch(
                    `/Inventario/Productos/Modificar/${idLocal}/${idProducto}`
                );

                if (!response.ok) throw new Error("No se pudo cargar la ventana.");

                const contenido = await response.text();
                document.getElementById("contenidoModalStock").innerHTML = contenido;

                const modalElement = document.getElementById("modalModificarStock");
                const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                modal.show();

            } catch (error) {
                mostrarToast("No se pudo cargar la ventana de modificación.", "error");
            }
        });

        // ============ CAMBIO DE ACCIÓN (Modificar) ============
        document.addEventListener("change", function (event) {
            if (event.target.id !== "accionAumentar" &&
                event.target.id !== "accionDescontar") {
                return;
            }

            const accion = event.target.value;
            const motivo = document.getElementById("motivo");
            if (!motivo) return;

            const motivos = {
                Aumentar: ["Producción", "Devolución (de cliente)", "Ajuste"],
                Descontar: ["Producto dañado/Merma", "Pérdida", "Ajuste"]
            };

            motivo.innerHTML = "";
            motivos[accion].forEach(function (nombreMotivo) {
                const option = document.createElement("option");
                option.value = nombreMotivo;
                option.textContent = nombreMotivo;
                motivo.appendChild(option);
            });
            motivo.selectedIndex = 0;
        });

        // ============ SUBMIT MODIFICAR ============
        document.addEventListener("submit", async function (event) {
            if (event.target.id !== "formModificarStock") return;

            event.preventDefault();

            const form = event.target;
            const botonGuardar = document.getElementById("btnGuardarStock");

            botonGuardar.disabled = true;
            botonGuardar.textContent = "Guardando...";

            try {
                const formData = new FormData(form);

                const response = await fetch("/Inventario/Productos/Modificar", {
                    method: "POST",
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    body: formData
                });

                const contentType = response.headers.get("content-type") || "";

                if (contentType.includes("application/json")) {
                    const resultado = await response.json();
                    if (!response.ok || !resultado.ok) {
                        throw new Error(resultado.mensaje || "No se pudo guardar el stock.");
                    }

                    bootstrap.Modal.getInstance(document.getElementById("modalModificarStock"))?.hide();
                    mostrarToast("GUARDADO EXITOSAMENTE", "success");

                    document.getElementById("local").dispatchEvent(new Event("change"));
                    return;
                }

                const contenido = await response.text();
                if (!response.ok) throw new Error("No se pudo procesar la modificación.");
                document.getElementById("contenidoModalStock").innerHTML = contenido;

            } catch (error) {
                mostrarToast(error.message || "Ocurrió un error al guardar el stock.", "error");
            } finally {
                const botonActual = document.getElementById("btnGuardarStock");
                if (botonActual) {
                    botonActual.disabled = false;
                    botonActual.textContent = "Guardar";
                }
            }
        });

        // ============ ABRIR MODAL BALANCEAR ============
        document.addEventListener("click", async function (event) {
            const boton = event.target.closest(".btn-balancear-bidones");
            if (!boton) return;

            const idLocal = boton.dataset.idLocal;
            const idProducto = boton.dataset.idProducto;

            try {
                const response = await fetch(
                    `/Inventario/Productos/Balancear/${idLocal}/${idProducto}`
                );

                if (!response.ok) throw new Error("No se pudo cargar la ventana.");

                const contenido = await response.text();
                document.getElementById("contenidoModalStock").innerHTML = contenido;

                const modalElement = document.getElementById("modalModificarStock");
                const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                modal.show();

            } catch (error) {
                mostrarToast("No se pudo cargar la ventana de balanceo.", "error");
            }
        });

        // ============ CAMBIO TIPO MOVIMIENTO ============
        document.addEventListener("change", function (event) {
            if (event.target.name !== "TipoMovimientoRadio") return;

            const tipo = event.target.value;
            const seccionEntrega = document.getElementById("seccionEntrega");
            const seccionProduccion = document.getElementById("seccionProduccion");
            const motivo = document.getElementById("motivo");
            const hiddenTipo = document.getElementById("TipoMovimientoHidden");

            if (!seccionEntrega || !seccionProduccion) return;

            if (hiddenTipo) hiddenTipo.value = tipo;

            if (tipo === "Produccion") {
                seccionEntrega.style.display = "none";
                seccionProduccion.style.display = "block";
                if (motivo) motivo.value = "Ajuste de inventario";
            } else {
                seccionEntrega.style.display = "block";
                seccionProduccion.style.display = "none";
                if (motivo) motivo.value = "Entrega a cliente";
            }
        });

        // ============ CAMBIO ACCIÓN PRODUCCIÓN ============
        document.addEventListener("change", function (event) {
            if (event.target.name !== "AccionProduccionRadio") return;

            const accion = event.target.value;
            const hiddenAccion = document.getElementById("AccionProduccionHidden");

            if (hiddenAccion) hiddenAccion.value = accion;
        });

        // ============ AUTOCOMPLETADO CLIENTE ============
        let debounceCliente = null;

        document.addEventListener("input", function (event) {
            if (event.target.id !== "inputBuscarCliente") return;

            clearTimeout(debounceCliente);
            const q = event.target.value.trim();

            debounceCliente = setTimeout(async () => {
                const dropdown = document.getElementById("dropdownClientes");
                if (!dropdown) return;

                if (q.length < 2) {
                    dropdown.style.display = "none";
                    return;
                }

                try {
                    const resp = await fetch(`/Inventario/Productos/BuscarClientes?q=${encodeURIComponent(q)}`);
                    if (!resp.ok) { dropdown.style.display = "none"; return; }

                    const clientes = await resp.json();
                    if (!clientes.length) {
                        dropdown.innerHTML = '<div style="padding:12px;font-size:12.5px;color:#6e6e73;text-align:center;">Sin resultados</div>';
                        dropdown.style.display = "block";
                        return;
                    }

                    dropdown.innerHTML = clientes.map(c => `
                        <button type="button"
                                class="dropdown-cliente-item"
                                data-id="${c.id}"
                                data-nombre="${escapeHtml(c.nombre)}"
                                data-telefono="${escapeHtml(c.telefono)}"
                                data-dni="${escapeHtml(c.dni || "")}"
                                data-saldo="${c.saldoBidones}"
                                style="display:block;width:100%;padding:10px 14px;background:transparent;border:none;text-align:left;cursor:pointer;font-size:13px;border-bottom:1px solid #f0f0f2;">
                            <div style="font-weight:600;color:#1d1d1f;">${escapeHtml(c.nombre)}</div>
                            <div style="font-size:11.5px;color:#6e6e73;margin-top:2px;">
                                ${escapeHtml(c.telefono)}${c.dni ? " · DNI " + escapeHtml(c.dni) : ""}
                            </div>
                        </button>
                    `).join("");
                    dropdown.style.display = "block";

                } catch {
                    dropdown.style.display = "none";
                }
            }, 300);
        });

        // ============ SELECCIONAR CLIENTE ============
        document.addEventListener("click", function (event) {
            const item = event.target.closest(".dropdown-cliente-item");
            if (!item) return;

            const id = item.dataset.id;
            const nombre = item.dataset.nombre;
            const telefono = item.dataset.telefono;
            const dni = item.dataset.dni;
            const saldo = Number(item.dataset.saldo || 0);

            document.getElementById("IdCliente").value = id;
            document.getElementById("clienteNombre").textContent = nombre;
            document.getElementById("clienteMeta").textContent =
                [telefono, dni ? `DNI ${dni}` : null].filter(Boolean).join(" · ");

            const info = formatearSaldo(saldo);
            document.getElementById("clienteSaldo").innerHTML =
                `<span style="color:${info.color};font-weight:600;">${info.texto}</span>`;

            document.getElementById("clienteSeleccionado").style.display = "block";
            document.getElementById("buscadorCliente").style.display = "none";
            document.getElementById("dropdownClientes").style.display = "none";
        });

        // ============ CAMBIAR CLIENTE ============
        document.addEventListener("click", function (event) {
            if (event.target.id !== "btnCambiarCliente") return;

            document.getElementById("IdCliente").value = "";
            document.getElementById("clienteSeleccionado").style.display = "none";
            document.getElementById("buscadorCliente").style.display = "block";
            document.getElementById("inputBuscarCliente").value = "";
            document.getElementById("inputBuscarCliente").focus();
        });

        // Cerrar dropdown al hacer click fuera
        document.addEventListener("click", function (event) {
            const dropdown = document.getElementById("dropdownClientes");
            if (!dropdown) return;
            if (!event.target.closest("#buscadorCliente")) {
                dropdown.style.display = "none";
            }
        });

        // ============ SUBMIT BALANCEAR ============
        document.addEventListener("submit", async function (event) {
            if (event.target.id !== "formBalancearBidones") return;

            event.preventDefault();

            const form = event.target;
            const boton = document.getElementById("btnGuardarBalance");
            const tipo = document.getElementById("TipoMovimientoHidden")?.value || "Entrega";

            // Validaciones según tipo
            if (tipo === "Entrega") {
                if (!document.getElementById("IdCliente").value) {
                    mostrarToast("Selecciona un cliente.", "error");
                    return;
                }
            } else {
                const producidos = Number(document.getElementById("bidonesProducidos").value || 0);
                if (producidos <= 0) {
                    mostrarToast("Ingresa una cantidad mayor a cero.", "error");
                    return;
                }
            }

            boton.disabled = true;
            boton.textContent = "Guardando...";

            try {
                const formData = new FormData(form);
                formData.set("TipoMovimiento", tipo);

                if (tipo === "Produccion") {
                    formData.set("BidonesLlenosEntregados", "0");
                    formData.set("BidonesVaciosDevueltos", "0");
                    formData.set("CantidadProduccion", document.getElementById("bidonesProducidos").value);
                    formData.set("AccionProduccion", document.getElementById("AccionProduccionHidden").value);
                    formData.set("IdCliente", "0");
                }

                const response = await fetch("/Inventario/Productos/Balancear", {
                    method: "POST",
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    body: formData
                });

                const contentType = response.headers.get("content-type") || "";

                if (contentType.includes("application/json")) {
                    const resultado = await response.json();
                    if (!response.ok || !resultado.ok) {
                        throw new Error(resultado.mensaje || "No se pudo guardar el balance.");
                    }

                    bootstrap.Modal.getInstance(document.getElementById("modalModificarStock"))?.hide();
                    mostrarToast(resultado.mensaje || "BALANCE GUARDADO CORRECTAMENTE", "success");

                    document.getElementById("local").dispatchEvent(new Event("change"));
                    return;
                }

                const contenido = await response.text();
                if (!response.ok) throw new Error("No se pudo procesar el balance.");
                document.getElementById("contenidoModalStock").innerHTML = contenido;

            } catch (error) {
                mostrarToast(error.message || "Ocurrió un error al guardar el balance.", "error");
            } finally {
                const botonActual = document.getElementById("btnGuardarBalance");
                if (botonActual) {
                    botonActual.disabled = false;
                    botonActual.textContent = "Guardar";
                }
            }
        });
    </script>
}