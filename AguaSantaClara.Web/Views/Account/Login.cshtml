@model AguaSantaClara.Web.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión - Agua Santa Clara S.A.C";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            height: 100%;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            letter-spacing: -0.011em;
        }

        /* ============================================================
           LOGIN FULL SCREEN MINIMALISTA
           ============================================================ */
        .login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background:
                linear-gradient(180deg, rgba(251, 252, 253, 0.30), rgba(251, 252, 253, 0.50)),
                url('/images/agua.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-repeat: no-repeat;
        }

        /* ============================================================
           TARJETA PRINCIPAL
           ============================================================ */
        .login-card {
            width: 100%;
            max-width: 420px;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: saturate(180%) blur(28px);
            -webkit-backdrop-filter: saturate(180%) blur(28px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 20px;
            padding: 44px 40px 40px;
            box-shadow:
                0 20px 50px rgba(0, 0, 0, 0.12),
                0 0 0 0.5px rgba(0, 0, 0, 0.04);
        }

        /* ============================================================
           TÍTULO
           ============================================================ */
        .login-title {
            font-family: 'JetBrains Mono', monospace;
            font-size: 17px;
            font-weight: 600;
            letter-spacing: -0.02em;
            text-transform: uppercase;
            color: #1d1d1f;
            text-align: center;
            margin: 0 0 6px;
        }

        .login-subtitle {
            font-size: 13px;
            color: #6e6e73;
            text-align: center;
            margin: 0 0 32px;
            letter-spacing: -0.005em;
        }

        /* ============================================================
           FORMULARIO
           ============================================================ */
        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            font-size: 12px;
            font-weight: 500;
            color: #6e6e73;
            margin-bottom: 7px;
            letter-spacing: -0.005em;
        }

        .form-input {
            width: 100%;
            height: 46px;
            padding: 0 16px;
            border: 1px solid #d2d2d7;
            border-radius: 10px;
            background: #ffffff;
            font-family: inherit;
            font-size: 14px;
            color: #1d1d1f;
            letter-spacing: -0.005em;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .form-input::placeholder {
            color: #a1a1a6;
        }

        .form-input:focus {
            outline: none;
            border-color: #1d1d1f;
            box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.06);
        }

        .input-error {
            font-size: 12px;
            color: #ff3b30;
            margin-top: 6px;
            display: block;
        }

        /* ============================================================
           VALIDATION SUMMARY
           ============================================================ */
        .validation-summary {
            background: #ffebea;
            border: 1px solid #ffd0cc;
            border-radius: 10px;
            padding: 12px 14px;
            margin-bottom: 20px;
            color: #ff3b30;
            font-size: 12.5px;
            line-height: 1.5;
        }

        .validation-summary ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        /* ============================================================
           BOTÓN
           ============================================================ */
        .btn-login {
            width: 100%;
            height: 48px;
            margin-top: 8px;
            background: #1d1d1f;
            color: #ffffff;
            border: none;
            border-radius: 10px;
            font-family: inherit;
            font-size: 14px;
            font-weight: 500;
            letter-spacing: -0.01em;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .btn-login:hover {
            background: #000000;
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
    
    </style>
</head>
<body>
    <main class="login-page">
        <div class="login-card">
            <h1 class="login-title">Agua Santa Clara S.A.C.</h1>
            <p class="login-subtitle">Ingrese sus credenciales para acceder</p>

            <form asp-action="Login" method="post">
                <input type="hidden" name="ReturnUrl" value="@ViewBag.ReturnUrl" />

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="validation-summary">
                        <ul>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <div class="form-group">
                    <label asp-for="Username" class="form-label">Usuario</label>
                    <input asp-for="Username" class="form-input" placeholder="Ingrese su usuario" autofocus autocomplete="username" />
                    <span asp-validation-for="Username" class="input-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <input asp-for="Password" class="form-input" placeholder="••••••••" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="input-error"></span>
                </div>

                <button type="submit" class="btn-login">Iniciar Sesión</button>
            </form>
        </div>
    </main>
</body>
</html>