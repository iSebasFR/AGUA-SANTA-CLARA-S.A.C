@model AguaSantaClara.Web.Models.NotificacionesDeudasViewModel

<div class="dropend">
    <button type="button"
            class="btn btn-light position-relative rounded-circle"
            style="width:40px;height:40px;"
            id="notificacionesDeudasToggle"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="Notificaciones de vencimiento de deudas">
        <i class="bi bi-bell"></i>
        @if (Model.Notificaciones.Count > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                @Model.Notificaciones.Count
                <span class="visually-hidden">deudas próximas a vencer</span>
            </span>
        }
    </button>
    <div class="dropdown-menu p-0 shadow"
         style="width:min(360px, calc(100vw - 32px));"
         aria-labelledby="notificacionesDeudasToggle">
        <div class="px-3 py-2 border-bottom">
            <strong class="small">Deudas próximas a vencer</strong>
        </div>
        @if (Model.Notificaciones.Count == 0)
        {
            <p class="small text-secondary px-3 py-3 mb-0">No hay deudas próximas a vencer.</p>
        }
        else
        {
            <div class="list-group list-group-flush" style="max-height:320px;overflow-y:auto;">
                @foreach (var notificacion in Model.Notificaciones)
                {
                    <div class="list-group-item">
                        <div class="fw-semibold">@notificacion.NombreCliente</div>
                        <div class="small text-secondary">
                            S/ @notificacion.Monto.ToString("0.00") · Vence
                            @notificacion.FechaVencimiento.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
