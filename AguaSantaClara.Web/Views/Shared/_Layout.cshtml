@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name;
    var roleName = User.IsInRole("Vendedora") ? "Vendedora"
        : User.IsInRole("Gerente") ? "Gerente"
        : User.IsInRole("Administradora") ? "Administradora"
        : "Usuario";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] - Agua Santa Clara</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body @(isAuthenticated ? "with-sidebar" : "guest-layout")">
    <div class="app-shell">

        @if (isAuthenticated)
        {
            <aside class="app-sidebar" id="appSidebar" aria-label="Navegación principal">

                <!-- ===== LOGO (sin ícono circular) ===== -->
                <div class="sidebar-brand-row">
                    <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                        <span class="sidebar-label">Agua Santa Clara</span>
                    </a>
                </div>

                <!-- ===== NAV ===== -->
                <nav class="sidebar-nav">

                    @if (User.IsInRole("Gerente"))
                    {
                        <div class="sidebar-section-title sidebar-label">General</div>
                        <a asp-controller="Home" asp-action="Index" class="sidebar-link">
                            <i class="bi bi-speedometer2"></i><span class="sidebar-label">Inicio</span>
                        </a>

                        <div class="sidebar-section-title sidebar-label">Administración</div>
                        <a asp-controller="Usuarios" asp-action="Index" class="sidebar-link">
                            <i class="bi bi-people"></i><span class="sidebar-label">Usuarios</span>
                        </a>
                        <a asp-controller="Pagos" asp-action="Index" class="sidebar-link">
                            <i class="bi bi-cash-coin"></i><span class="sidebar-label">Pagos / Finanzas</span>
                        </a>
                    }
                    else if (User.IsInRole("Administradora"))
                    {
                        <div class="sidebar-section-title sidebar-label">General</div>
                        <a asp-controller="Home" asp-action="Index" class="sidebar-link">
                            <i class="bi bi-speedometer2"></i><span class="sidebar-label">Inicio</span>
                        </a>

                        <div class="sidebar-section-title sidebar-label">Gestión</div>
                        <a asp-controller="Clientes" asp-action="Index" class="sidebar-link">
                            <i class="bi bi-person-vcard"></i><span class="sidebar-label">Clientes</span>
                        </a>

                        <!-- Catálogo desplegable -->
                        <button type="button" class="sidebar-link sidebar-toggle"
                                data-bs-toggle="collapse" data-bs-target="#menuCatalogo"
                                aria-expanded="false" aria-controls="menuCatalogo">
                            <i class="bi bi-box-seam"></i>
                            <span class="sidebar-label">Catálogo</span>
                            <i class="bi bi-chevron-down sidebar-chevron"></i>
                        </button>
                        <div class="collapse sidebar-submenu" id="menuCatalogo">
                            <a asp-controller="Productos" asp-action="Index" class="sidebar-sublink">
                                <span class="sidebar-label">Productos</span>
                            </a>
                            <a asp-controller="Insumos" asp-action="Index" class="sidebar-sublink">
                                <span class="sidebar-label">Insumos</span>
                            </a>
                        </div>

                        <div class="sidebar-section-title sidebar-label">Operaciones</div>
                        <a asp-controller="Repartidores" asp-action="Index" class="sidebar-link">
                            <i class="bi bi-truck"></i><span class="sidebar-label">Repartidores</span>
                        </a>
                        <a asp-controller="Pagos" asp-action="Index" class="sidebar-link">
                            <i class="bi bi-cash-coin"></i><span class="sidebar-label">Pagos / Finanzas</span>
                        </a>
                    }
                    else if (User.IsInRole("Vendedora"))
                    {
                        <div class="sidebar-section-title sidebar-label">General</div>
                        <a asp-controller="Home" asp-action="Index" class="sidebar-link">
                            <i class="bi bi-speedometer2"></i><span class="sidebar-label">Inicio</span>
                        </a>

                        <div class="sidebar-section-title sidebar-label">Operaciones</div>
                        <a asp-controller="Clientes" asp-action="Index" class="sidebar-link">
                            <i class="bi bi-person-vcard"></i><span class="sidebar-label">Clientes</span>
                        </a>
                        <a asp-controller="Pedidos" asp-action="Index" class="sidebar-link">
                            <i class="bi bi-cart-check"></i><span class="sidebar-label">Pedidos</span>
                        </a>

                        <!-- Inventario desplegable para Vendedora -->
                        <button type="button"
                                class="sidebar-link sidebar-toggle"
                                data-bs-toggle="collapse"
                                data-bs-target="#menuInventarioVendedora"
                                aria-expanded="false"
                                aria-controls="menuInventarioVendedora">
                            <i class="bi bi-boxes"></i>
                            <span class="sidebar-label">Inventario</span>
                            <i class="bi bi-chevron-down sidebar-chevron"></i>
                        </button>

                        <div class="collapse sidebar-submenu" id="menuInventarioVendedora">
                            <a asp-controller="InventarioProductos"
                               asp-action="Index"
                               class="sidebar-sublink">
                                <span class="sidebar-label">Productos</span>
                            </a>

                            <a asp-controller="InventarioInsumos"
                               asp-action="Index"
                               class="sidebar-sublink">
                                <span class="sidebar-label">Insumos</span>
                            </a>
                        </div>
                    }
                </nav>

                <!-- ===== CUENTA (sin ícono de avatar, sin notificaciones) ===== -->
                <div class="sidebar-account">
                    <div class="account-copy sidebar-label">
                        <strong>@userName</strong>
                        <span>@roleName</span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout">
                        <button type="submit" title="Cerrar sesión" aria-label="Cerrar sesión">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </aside>
            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
        }

        <div class="app-main">
            <header class="app-topbar">
                @if (isAuthenticated)
                {
                    <button type="button" id="sidebarToggle" class="icon-button" aria-label="Abrir menú" aria-expanded="false" title="Menú">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="topbar-caption">Sistema de Pedidos y Distribución de la empresa Agua Santa Clara S.A.C</span>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="guest-brand">Agua Santa Clara</a>
                    <span class="topbar-caption">Sistema de Pedidos y Distribución</span>
                }
            </header>

            <main class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>&copy; @DateTime.Now.Year Agua Santa Clara S.A.C.</span>
                <span>Versión 1.0.0</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>