@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name;
    var roleName = User.IsInRole("Vendedora") ? "Vendedora"
        : User.IsInRole("Gerente") ? "Gerente"
        : User.IsInRole("Administradora") ? "Administradora"
        : "Usuario";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - Agua Santa Clara</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* ===== Sidebar submenús ===== */
        .sidebar-toggle {
            width: 100%;
            background: transparent;
            border: none;
            text-align: left;
            cursor: pointer;
            color: inherit;
            font: inherit;
        }
        .sidebar-toggle .sidebar-chevron {
            margin-left: auto;
            font-size: 0.75rem;
            transition: transform 0.2s ease;
        }
        .sidebar-toggle[aria-expanded="true"] .sidebar-chevron {
            transform: rotate(180deg);
        }
        .sidebar-submenu {
            display: flex;
            flex-direction: column;
            padding-left: 1rem;
        }
        .sidebar-sublink {
            display: flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.4rem 0.75rem;
            color: inherit;
            text-decoration: none;
            font-size: 0.875rem;
            border-radius: 0.375rem;
            opacity: 0.85;
        }
        .sidebar-sublink:hover {
            opacity: 1;
            background: rgba(255, 255, 255, 0.06);
        }
        .sidebar-sublink i {
            font-size: 1.25rem;
            line-height: 1;
        }
    </style>
</head>
<body class="app-body @(isAuthenticated ? "with-sidebar" : "guest-layout")">
    <div class="app-shell">
        @if (isAuthenticated)
        {
            <aside class="app-sidebar" id="appSidebar" aria-label="Navegación principal">
                <div class="sidebar-brand-row">
                    <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                        <span class="sidebar-brand-mark">AS</span>
                        <span class="sidebar-label">Agua Santa Clara</span>
                    </a>
                </div>

                <nav class="sidebar-nav">
                    @if (User.IsInRole("Gerente"))
                    {
                        @* ===== MENÚ GERENTE ===== *@
                        <a asp-controller="Home" asp-action="Index" class="sidebar-link" title="Inicio">
                            <i class="bi bi-speedometer2"></i><span class="sidebar-label">Inicio</span>
                        </a>
                        <a asp-controller="Usuarios" asp-action="Index" class="sidebar-link" title="Usuarios">
                            <i class="bi bi-people"></i><span class="sidebar-label">Usuarios</span>
                        </a>
                        <a asp-controller="Pagos" asp-action="Index" class="sidebar-link" title="Pagos y Finanzas">
                            <i class="bi bi-cash-coin"></i><span class="sidebar-label">Pagos / Finanzas</span>
                        </a>
                    }
                    else if (User.IsInRole("Administradora"))
                    {
                        @* ===== MENÚ ADMINISTRADORA ===== *@
                        <a asp-controller="Home" asp-action="Index" class="sidebar-link" title="Inicio">
                            <i class="bi bi-speedometer2"></i><span class="sidebar-label">Inicio</span>
                        </a>
                        <a asp-controller="Clientes" asp-action="Index" class="sidebar-link" title="Clientes">
                            <i class="bi bi-person-vcard"></i><span class="sidebar-label">Clientes</span>
                        </a>

                        @* Catálogo (desplegable) *@
                        <button type="button" class="sidebar-link sidebar-toggle"
                                data-bs-toggle="collapse" data-bs-target="#menuCatalogo"
                                aria-expanded="false" aria-controls="menuCatalogo" title="Catálogo">
                            <i class="bi bi-box-seam"></i>
                            <span class="sidebar-label">Catálogo</span>
                            <i class="bi bi-chevron-down sidebar-chevron"></i>
                        </button>
                        <div class="collapse sidebar-submenu" id="menuCatalogo">
                            <a asp-controller="Productos" asp-action="Index" class="sidebar-sublink">
                                <i class="bi bi-dot"></i><span class="sidebar-label">Productos</span>
                            </a>
                            <a asp-controller="Insumos" asp-action="Index" class="sidebar-sublink">
                                <i class="bi bi-dot"></i><span class="sidebar-label">Insumos</span>
                            </a>
                        </div>

                        @* Inventario (desplegable) *@
                        <button type="button" class="sidebar-link sidebar-toggle"
                                data-bs-toggle="collapse" data-bs-target="#menuInventario"
                                aria-expanded="false" aria-controls="menuInventario" title="Inventario">
                            <i class="bi bi-boxes"></i>
                            <span class="sidebar-label">Inventario</span>
                            <i class="bi bi-chevron-down sidebar-chevron"></i>
                        </button>
                        <div class="collapse sidebar-submenu" id="menuInventario">
                            <a asp-controller="Inventario" asp-action="Productos" class="sidebar-sublink">
                                <i class="bi bi-dot"></i><span class="sidebar-label">Productos</span>
                            </a>
                            <a asp-controller="Inventario" asp-action="Insumos" class="sidebar-sublink">
                                <i class="bi bi-dot"></i><span class="sidebar-label">Insumos</span>
                            </a>
                        </div>

                        <a asp-controller="Repartidores" asp-action="Index" class="sidebar-link" title="Repartidores">
                            <i class="bi bi-truck"></i><span class="sidebar-label">Repartidores</span>
                        </a>

                        <a asp-controller="Pagos" asp-action="Index" class="sidebar-link" title="Pagos y Finanzas">
                            <i class="bi bi-cash-coin"></i><span class="sidebar-label">Pagos / Finanzas</span>
                        </a>
                    }
                    else if (User.IsInRole("Vendedora"))
                    {
                        @* ===== MENÚ VENDEDORA ===== *@
                        <a asp-controller="Home" asp-action="Index" class="sidebar-link" title="Inicio">
                            <i class="bi bi-speedometer2"></i><span class="sidebar-label">Inicio</span>
                        </a>
                        <a asp-controller="Clientes" asp-action="Index" class="sidebar-link" title="Clientes">
                            <i class="bi bi-person-vcard"></i><span class="sidebar-label">Clientes</span>
                        </a>
                        <a asp-controller="Pedidos" asp-action="Index" class="sidebar-link" title="Pedidos">
                            <i class="bi bi-cart-check"></i><span class="sidebar-label">Pedidos</span>
                        </a>
                    }
                </nav>

                <div class="sidebar-account">
                    <div class="account-avatar" aria-hidden="true"><i class="bi bi-person"></i></div>
                    <div class="account-copy sidebar-label">
                        <strong>@userName</strong>
                        <span>@roleName</span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout">
                        <button type="submit" title="Cerrar sesión" aria-label="Cerrar sesión">
                            <i class="bi bi-box-arrow-right"></i><span class="sidebar-label">Salir</span>
                        </button>
                    </form>
                </div>
            </aside>
            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
        }

        <div class="app-main">
            <header class="app-topbar">
                @if (isAuthenticated)
                {
                    <button type="button" id="sidebarToggle" class="icon-button" aria-label="Abrir menú" aria-expanded="false" title="Menú">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="topbar-caption">Sistema de Pedidos y Distribución</span>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="guest-brand">Agua Santa Clara</a>
                    <span class="topbar-caption">Sistema de Pedidos y Distribución</span>
                }
            </header>

            <main class="app-content">
                @if (isAuthenticated)
                {
                    <div class="page-heading">
                        <h1>@ViewData["Title"]</h1>
                        <span>Agua Santa Clara S.A.C.</span>
                    </div>
                }
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>&copy; @DateTime.Now.Year Agua Santa Clara S.A.C.</span>
                <span>Versión 1.0.0</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>